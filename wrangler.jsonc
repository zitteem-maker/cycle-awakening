// Configuration Cloudflare Workers (déploiement depuis GitHub, branche main = production,
// autres branches = liens de prévisualisation). Le site est 100 % statique (dist/, construit par
// `npm run build`) ; seule la route /api/newsletter passe par le code du Worker.
// Les secrets (BREVO_API_KEY…) se règlent dans Cloudflare, jamais ici. Voir .env.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cycle-awakening",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "preview_urls": true,
  "workers_dev": true,
  "observability": { "enabled": true }
}
