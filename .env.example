# Cycle Awakening — variables d'environnement
# Copier en .env pour le développement local (.env n'est jamais commité).
# En production : Cloudflare Pages > projet > Settings > Variables and Secrets (Production ET Preview).
# Règle : tout ce qui commence par PUBLIC_ est visible dans le navigateur → JAMAIS de secret avec ce préfixe.

# ── Site (étape 1) ───────────────────────────────────────────────
# URL canonique, sans slash final. Sert aux balises Open Graph, au sitemap, aux liens UTM.
PUBLIC_SITE_URL=https://cycleawakening.com

# Lien de paiement du guide (Stripe Payment Link, option A). Vide = CTA « être prévenue de la sortie ».
# Utiliser le lien de TEST en Preview et le lien LIVE en Production.
PUBLIC_CHECKOUT_URL=
# (Optionnel) Liens de paiement du site anglais dans les autres devises, un lien Stripe par devise.
# Une devise n'est proposée que si son prix est confirmé dans src/config/offers.ts (guidePrices) ET si son lien existe.
PUBLIC_CHECKOUT_URL_USD=
PUBLIC_CHECKOUT_URL_GBP=

# Modules grossesse / pré-conception / post-partum. Reste à false tant que la relecture
# professionnelle n'est pas faite ET validée par écrit.
FEATURE_PREGNANCY_MODULES=false

# ── Étape 3 — Newsletter (Brevo, double opt-in) ─────────────────
# Lus uniquement par la fonction serveur functions/api/newsletter.js. Tant qu'ils sont vides,
# le formulaire répond « les inscriptions ouvrent bientôt » (aucune inscription simulée).
# BREVO_API_KEY : Brevo > Paramètres > SMTP & API > Clés API. Type « Secret » dans Cloudflare.
BREVO_API_KEY=
# Identifiant numérique de la liste « Newsletter » (Brevo > Contacts > Listes).
BREVO_LIST_ID=
# Modèle d'email de confirmation double opt-in (Brevo > Campagnes > Modèles, balise {{ doubleoptin }}).
BREVO_DOI_TEMPLATE_ID=
# (Optionnel) Modèle de confirmation double opt-in en anglais, pour les inscriptions depuis /en. À défaut : le modèle français.
BREVO_DOI_TEMPLATE_ID_EN=

# ── Secrets à venir (NE PAS remplir maintenant, ne jamais préfixer par PUBLIC_) ──
# Étape 4 option B — Stripe (Cloudflare Pages Functions) : à déclarer en type « Secret » (chiffré).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Étape 6 — Supabase (la clé service_role ne va JAMAIS côté navigateur)
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Étape 7 — Assistante IA (appels côté serveur uniquement)
# ANTHROPIC_API_KEY=
