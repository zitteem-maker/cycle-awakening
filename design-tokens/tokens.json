{
  "$description": "Source unique de vérité du design Cycle Awakening. Utilisée par le site, l'espace membre et le livre PDF. Ne pas modifier les fichiers générés : modifier ce fichier puis lancer `npm run tokens`.",
  "color": {
    "base": {
      "$description": "Base claire — environ 70 % de la surface",
      "creme": {
        "value": "#F7F4EF",
        "usage": "Fond principal"
      },
      "beige": {
        "value": "#EDE8E0",
        "usage": "Fond secondaire, cartes"
      },
      "beige-ombre": {
        "value": "#E3DDD4",
        "usage": "Fonds de blocs « pas pour toi », séparateurs pleins"
      },
      "sauge": {
        "value": "#9FC0B0",
        "usage": "Texte secondaire et détails sur fond vert bouteille ; aplats décoratifs sur fond clair (jamais en texte sur clair)"
      },
      "gris": {
        "value": "#5C5C5C",
        "usage": "Texte secondaire sur fond clair"
      }
    },
    "profondeur": {
      "$description": "Vert bouteille — environ 20 % de la surface",
      "vert-bouteille": {
        "value": "#1A3028",
        "usage": "Texte principal, fonds profonds, boutons principaux"
      },
      "vert-mousse": {
        "value": "#2D4A3E",
        "usage": "Liens, citations, fonds profonds secondaires"
      },
      "vert-nuit": {
        "value": "#122219",
        "usage": "Bas des dégradés profonds (jamais de noir pur)"
      }
    },
    "accent": {
      "$description": "Fuchsia — 10 % maximum, réservé au logo et aux italiques signature",
      "fuchsia": {
        "value": "#E0257A",
        "usage": "Logo, mots en italique signature dans les titres (grands textes uniquement : 4,06:1 sur crème)"
      },
      "fuchsia-profond": {
        "value": "#C4206A",
        "usage": "Fuchsia pour petit texte sur fond clair (5,09:1), survol"
      }
    }
  },
  "semantic": {
    "$description": "Rôles. Le site et le PDF n'utilisent que ces noms, pas les couleurs brutes.",
    "bg": "{color.base.creme}",
    "bg-alt": "{color.base.beige}",
    "bg-muted": "{color.base.beige-ombre}",
    "bg-deep": "{color.profondeur.vert-bouteille}",
    "bg-deep-alt": "{color.profondeur.vert-mousse}",
    "bg-deep-intense": "{color.profondeur.vert-nuit}",
    "text": "{color.profondeur.vert-bouteille}",
    "text-muted": "{color.base.gris}",
    "text-on-deep": "{color.base.creme}",
    "text-on-deep-muted": "{color.base.sauge}",
    "link": "{color.profondeur.vert-mousse}",
    "line": "{color.base.beige-ombre}",
    "accent": "{color.accent.fuchsia}",
    "accent-text": "{color.accent.fuchsia-profond}",
    "cta-bg": "{color.profondeur.vert-bouteille}",
    "cta-text": "{color.base.creme}",
    "cta-bg-hover": "{color.profondeur.vert-mousse}",
    "cta-on-deep-bg": "{color.base.creme}",
    "cta-on-deep-text": "{color.profondeur.vert-bouteille}",
    "focus": "{color.accent.fuchsia-profond}",
    "focus-on-deep": "{color.base.creme}"
  },
  "contrast-pairs": {
    "$description": "Couples texte/fond contrôlés par `npm run check:contrast` (WCAG AA : 4.5 texte courant, 3 grands textes et éléments d'interface).",
    "pairs": [
      {
        "fg": "text",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "text",
        "bg": "bg-alt",
        "min": 4.5
      },
      {
        "fg": "text",
        "bg": "bg-muted",
        "min": 4.5
      },
      {
        "fg": "text-muted",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "text-muted",
        "bg": "bg-alt",
        "min": 4.5
      },
      {
        "fg": "text-muted",
        "bg": "bg-muted",
        "min": 4.5
      },
      {
        "fg": "link",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "text-on-deep",
        "bg": "bg-deep",
        "min": 4.5
      },
      {
        "fg": "text-on-deep",
        "bg": "bg-deep-alt",
        "min": 4.5
      },
      {
        "fg": "text-on-deep",
        "bg": "bg-deep-intense",
        "min": 4.5
      },
      {
        "fg": "text-on-deep-muted",
        "bg": "bg-deep",
        "min": 4.5
      },
      {
        "fg": "text-on-deep-muted",
        "bg": "bg-deep-alt",
        "min": 4.5
      },
      {
        "fg": "accent",
        "bg": "bg",
        "min": 3
      },
      {
        "fg": "accent",
        "bg": "bg-alt",
        "min": 3
      },
      {
        "fg": "accent",
        "bg": "bg-deep",
        "min": 3
      },
      {
        "fg": "accent-text",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "cta-text",
        "bg": "cta-bg",
        "min": 4.5
      },
      {
        "fg": "cta-text",
        "bg": "cta-bg-hover",
        "min": 4.5
      },
      {
        "fg": "cta-on-deep-text",
        "bg": "cta-on-deep-bg",
        "min": 4.5
      },
      {
        "fg": "focus",
        "bg": "bg",
        "min": 3
      },
      {
        "fg": "focus-on-deep",
        "bg": "bg-deep",
        "min": 3
      }
    ]
  },
  "font": {
    "family": {
      "display": {
        "value": "'Cormorant Garamond', 'Playfair Display', Georgia, serif"
      },
      "body": {
        "value": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif"
      }
    },
    "weight": {
      "regular": {
        "value": "400"
      },
      "medium": {
        "value": "500"
      },
      "semibold": {
        "value": "600"
      }
    },
    "size": {
      "$description": "Échelle fluide, mobile d'abord (min à 360 px, max à 1280 px).",
      "xs": {
        "value": "0.8125rem"
      },
      "sm": {
        "value": "0.9375rem"
      },
      "base": {
        "value": "1.0625rem"
      },
      "lg": {
        "value": "clamp(1.1875rem, 1.1rem + 0.4vw, 1.375rem)"
      },
      "xl": {
        "value": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)"
      },
      "2xl": {
        "value": "clamp(2rem, 1.6rem + 1.8vw, 3rem)"
      },
      "3xl": {
        "value": "clamp(2.5rem, 1.8rem + 3.2vw, 4.5rem)"
      }
    },
    "line-height": {
      "tight": {
        "value": "1.1"
      },
      "snug": {
        "value": "1.3"
      },
      "body": {
        "value": "1.65"
      }
    }
  },
  "space": {
    "$description": "Le contenu respire comme le message : sections très aérées.",
    "1": {
      "value": "0.25rem"
    },
    "2": {
      "value": "0.5rem"
    },
    "3": {
      "value": "0.75rem"
    },
    "4": {
      "value": "1rem"
    },
    "6": {
      "value": "1.5rem"
    },
    "8": {
      "value": "2rem"
    },
    "12": {
      "value": "3rem"
    },
    "16": {
      "value": "4rem"
    },
    "section": {
      "value": "clamp(4.5rem, 3rem + 7vw, 9rem)"
    },
    "gutter": {
      "value": "clamp(1.25rem, 0.8rem + 2vw, 2.5rem)"
    }
  },
  "size": {
    "content": {
      "value": "68ch"
    },
    "container": {
      "value": "72rem"
    },
    "tap-target": {
      "value": "2.75rem"
    }
  },
  "radius": {
    "sm": {
      "value": "4px"
    },
    "md": {
      "value": "10px"
    },
    "pill": {
      "value": "999px"
    }
  },
  "motion": {
    "$description": "Un seul moment d'animation marquant (hero). Le reste : transitions d'état courtes. Tout est coupé si prefers-reduced-motion.",
    "duration-fast": {
      "value": "160ms"
    },
    "duration-base": {
      "value": "260ms"
    },
    "duration-hero": {
      "value": "1400ms"
    },
    "ease": {
      "value": "cubic-bezier(0.22, 0.61, 0.36, 1)"
    }
  },
  "print": {
    "$description": "Valeurs du livre PDF (A4, marges généreuses).",
    "page-size": {
      "value": "A4"
    },
    "margin-inner": {
      "value": "24mm"
    },
    "margin-outer": {
      "value": "20mm"
    },
    "margin-top": {
      "value": "22mm"
    },
    "margin-bottom": {
      "value": "26mm"
    }
  },
  "shadow": {
    "$description": "Ombres douces teintées vert bouteille, jamais grises ni dures.",
    "soft": {
      "value": "0 1px 2px rgba(26, 48, 40, 0.05), 0 8px 24px -12px rgba(26, 48, 40, 0.16)"
    },
    "lift": {
      "value": "0 2px 4px rgba(26, 48, 40, 0.06), 0 18px 40px -18px rgba(26, 48, 40, 0.26)"
    }
  },
  "texture": {
    "$description": "Grain papier, très discret (repris de l'ancien site).",
    "grain-opacity": {
      "value": "0.05"
    }
  }
