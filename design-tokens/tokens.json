{
  "$description": "Source unique de vérité du design Cycle Awakening. Utilisée par le site, l'espace membre et le livre PDF. Ne pas modifier les fichiers générés : modifier ce fichier puis lancer `npm run tokens`.",
  "color": {
    "base": {
      "$description": "Minéral doux — 70 % de la surface",
      "creme-sable": { "value": "#F4F1EC", "usage": "Fond principal" },
      "beige-doux": { "value": "#EDE7DF", "usage": "Fond secondaire, cartes" },
      "vert-sauge": { "value": "#A8B5A2", "usage": "Décoratif uniquement (filets, pictos, aplats). Jamais en couleur de texte sur fond clair." },
      "brun-lin": { "value": "#6B5E53", "usage": "Texte secondaire, légendes" }
    },
    "nuit": {
      "$description": "Nuit douce — 20 % de la surface",
      "bleu-nuit": { "value": "#2E3A44", "usage": "Texte principal sur fond clair, fonds sombres" },
      "vert-profond": { "value": "#3F5A54", "usage": "Fonds sombres, liens, états actifs" },
      "gris-brume": { "value": "#A5B1B5", "usage": "Texte secondaire sur fond sombre, bordures" }
    },
    "accent": {
      "$description": "Or doux — 10 % maximum",
      "or-doux": { "value": "#D6B38A", "usage": "Boutons principaux (avec texte bleu nuit), détails premium. Jamais en texte sur fond clair." }
    }
  },
  "semantic": {
    "$description": "Rôles. Le site et le PDF n'utilisent que ces noms, pas les couleurs brutes.",
    "bg": "{color.base.creme-sable}",
    "bg-alt": "{color.base.beige-doux}",
    "bg-deep": "{color.nuit.bleu-nuit}",
    "bg-deep-alt": "{color.nuit.vert-profond}",
    "text": "{color.nuit.bleu-nuit}",
    "text-muted": "{color.base.brun-lin}",
    "text-on-deep": "{color.base.creme-sable}",
    "text-on-deep-muted": "{color.nuit.gris-brume}",
    "link": "{color.nuit.vert-profond}",
    "line": "{color.base.vert-sauge}",
    "accent": "{color.accent.or-doux}",
    "cta-bg": "{color.accent.or-doux}",
    "cta-text": "{color.nuit.bleu-nuit}",
    "focus": "{color.nuit.vert-profond}",
    "focus-on-deep": "{color.accent.or-doux}"
  },
  "contrast-pairs": {
    "$description": "Couples texte/fond contrôlés par `npm run check:contrast` (WCAG AA : 4.5 texte courant, 3 grands textes).",
    "pairs": [
      { "fg": "text", "bg": "bg", "min": 4.5 },
      { "fg": "text", "bg": "bg-alt", "min": 4.5 },
      { "fg": "text-muted", "bg": "bg", "min": 4.5 },
      { "fg": "text-muted", "bg": "bg-alt", "min": 4.5 },
      { "fg": "link", "bg": "bg", "min": 4.5 },
      { "fg": "text-on-deep", "bg": "bg-deep", "min": 4.5 },
      { "fg": "text-on-deep", "bg": "bg-deep-alt", "min": 4.5 },
      { "fg": "text-on-deep-muted", "bg": "bg-deep", "min": 4.5 },
      { "fg": "cta-text", "bg": "cta-bg", "min": 4.5 },
      { "fg": "focus", "bg": "bg", "min": 3 },
      { "fg": "focus-on-deep", "bg": "bg-deep", "min": 3 }
    ]
  },
  "font": {
    "family": {
      "display": { "value": "'Cormorant Garamond', 'Playfair Display', Georgia, serif" },
      "body": { "value": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" }
    },
    "size": {
      "$description": "Échelle fluide, mobile d'abord (min à 360 px, max à 1280 px).",
      "xs": { "value": "0.8125rem" },
      "sm": { "value": "0.9375rem" },
      "base": { "value": "1.0625rem" },
      "lg": { "value": "clamp(1.1875rem, 1.1rem + 0.4vw, 1.375rem)" },
      "xl": { "value": "clamp(1.5rem, 1.3rem + 0.9vw, 2rem)" },
      "2xl": { "value": "clamp(2rem, 1.6rem + 1.8vw, 3rem)" },
      "3xl": { "value": "clamp(2.5rem, 1.8rem + 3.2vw, 4.5rem)" }
    },
    "line-height": {
      "tight": { "value": "1.1" },
      "snug": { "value": "1.3" },
      "body": { "value": "1.65" }
    }
  },
  "space": {
    "$description": "Le contenu respire comme le message : sections très aérées.",
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "section": { "value": "clamp(4.5rem, 3rem + 7vw, 9rem)" },
    "gutter": { "value": "clamp(1.25rem, 0.8rem + 2vw, 2.5rem)" }
  },
  "size": {
    "content": { "value": "68ch" },
    "container": { "value": "72rem" },
    "tap-target": { "value": "2.75rem" }
  },
  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "10px" },
    "pill": { "value": "999px" }
  },
  "motion": {
    "$description": "Un seul moment d'animation marquant (hero). Le reste : transitions d'état courtes. Tout est coupé si prefers-reduced-motion.",
    "duration-fast": { "value": "160ms" },
    "duration-base": { "value": "260ms" },
    "duration-hero": { "value": "1400ms" },
    "ease": { "value": "cubic-bezier(0.22, 0.61, 0.36, 1)" }
  },
  "print": {
    "$description": "Valeurs du livre PDF (A4, marges généreuses).",
    "page-size": { "value": "A4" },
    "margin-inner": { "value": "24mm" },
    "margin-outer": { "value": "20mm" },
    "margin-top": { "value": "22mm" },
    "margin-bottom": { "value": "26mm" }
  }
}
