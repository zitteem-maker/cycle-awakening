{
  "name": "cycle-awakening",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Cycle Awakening — site, livre et espace membre",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "share-image": "node scripts/build-share-image.mjs",
    "utm": "node --env-file-if-exists=.env scripts/build-utm.mjs",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens && npm run check:contrast",
    "build": "astro build",
    "preview": "astro preview",
    "logo": "node scripts/build-logo.mjs",
    "hero-video": "node scripts/process-hero-video.mjs",
    "build:book": "npm run tokens && node book/build.mjs",
    "build:book:brouillon": "npm run tokens && node book/build.mjs --brouillon"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@fontsource/allura": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/ephesis": "^5.3.0",
    "@fontsource/federo": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/mea-culpa": "^5.3.0",
    "@fontsource/monsieur-la-doulaise": "^5.3.0",
    "@fontsource/poiret-one": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "marked": "^18.1.0",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0"
  }
}
