---
// Page d'accueil, en français (/) et en anglais (/en). Textes dans `textes` ci-dessous, markup commun.
// Structure : hero, bandeau, faits, problème, cycle, histoire, guide, pour qui, offre, FAQ, newsletter.
// Règles : aucun chiffre ni témoignage inventé (les faits viennent du vrai livre), aucune promesse de résultat.
import PageLayout from '../layouts/PageLayout.astro';
import Cta from '../components/Cta.astro';
import CycleWheel from '../components/home/CycleWheel.astro';
import Marquee from '../components/home/Marquee.astro';
import CyclePhases from '../components/home/CyclePhases.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { guide, formatPrice } from '../config/offers';
import { chapitres, recettes, outils } from '../data/livre';
import { langOf, intlLocale } from '../i18n';

const lang = langOf(Astro.url);
const en = lang === 'en';

// Portrait de la fondatrice : affiché dès que le fichier existe (public/images/site/emeline.webp).
// (recherche faite au build par Vite, compatible avec tous les environnements de rendu)
const portrait = Object.keys(import.meta.glob('../../public/images/site/emeline.webp')).length ? '/images/site/emeline.webp' : null;

const prix = formatPrice(guide.priceCents, intlLocale[lang]);
const pages = guide.pages;
const photosRecettes: Record<string, string> = {
  'banana-bread.jpg': '/images/site/banana-bread.webp',
  'cookies-pois-chiches.jpg': '/images/site/cookies.webp',
  'dorade-fenouil.jpg': '/images/site/poisson-fenouil.webp',
  'lait-dor-chai.jpg': '/images/site/lait-dor.webp',
};
const vitrine = recettes.filter((r) => photosRecettes[r.photo]).slice(0, 4).map((r) => ({
  photo: r.photo,
  nom: en ? r.nom_en : r.nom,
  titre: en ? r.titre_en : r.titre,
  temps: en ? r.temps_en : r.temps,
}));
const chap = chapitres.map((c) => ({ ordre: c.ordre, titre: en ? c.titre_en : c.titre, accroche: en ? c.accroche_en : c.accroche }));
const nomsOutils = outils.map((o) => (en ? o.titre_en : o.titre).replace(/ — .*/, '').replace(/^./, (c) => c.toLowerCase()));

const fr = {
  description: undefined as string | undefined,
  heroEyebrow: 'Le guide de ta fin de cycle · J17–J28',
  heroL1: 'Tu n’es pas', heroL2: 'instable.', heroL3: 'Tu es cyclique.',
  heroLead: 'Fatigue, irritabilité, ventre gonflé, envie de disparaître quelques jours par mois : ta phase lutéale a une logique. Comprends-la, et organise-toi avec elle, pas contre elle.',
  heroLien: 'Découvrir le guide',
  faitsAria: 'Le guide en chiffres',
  faits: [
    { chiffre: String(chapitres.length), libelle: 'chapitres pour comprendre et agir' },
    { chiffre: String(recettes.length), libelle: 'recettes simples de fin de cycle' },
    { chiffre: String(outils.length), libelle: 'outils à imprimer, dont un bonus' },
    { chiffre: '0', libelle: 'régime, 0 calorie comptée' },
  ],
  phrases: ['Tu n’es pas instable. Tu es cyclique.', 'Ralentir est une stratégie hormonale.', 'Comprendre avant de changer.', 'Redevenir toi. Chaque mois.'],
  probEyebrow: 'Le problème',
  probTitre: 'Tu te <em class="accent">reconnais</em> ?',
  probChute: 'Ce n’est pas dans ta tête. Ce n’est pas un manque de volonté. C’est une phase de ton cycle, avec ses propres règles.',
  reconnais: [
    'Je ne comprends pas pourquoi je deviens une autre personne avant mes règles.',
    'Je mange bien, je fais du sport. Et pourtant, chaque mois, je m’effondre.',
    'J’ai l’impression de perdre qui je suis pendant sept à dix jours.',
    'Je suis fatiguée de tout tester sans comprendre ce qui se passe vraiment.',
    'Les conseils sont soit trop médicaux, soit trop vagues.',
  ],
  guillemets: ['« ', ' »'],
  cycleEyebrow: 'Comprendre d’abord',
  cycleTitre: 'Ton cycle en <em class="accent">quatre temps</em>',
  histEyebrow: 'Mon histoire',
  histTitre: 'Le problème n’est pas ta <em class="accent">discipline.</em>',
  histTexte: 'Pendant des années, j’ai vécu exactement ça : disparaître quelques jours par mois sans comprendre pourquoi. J’ai cherché, testé, croisé nutrition, mouvement et compréhension du cycle. Ce guide, c’est celui que j’aurais voulu trouver : <em>simple, concret, sans culpabilité.</em>',
  portraitAlt: 'Emeline, fondatrice de Cycle Awakening',
  role: 'Fondatrice de Cycle Awakening',
  livreTitre: 'Le Guide',
  livreSous: 'Comprendre et traverser ta phase lutéale,<br />J17–J28',
  guideEyebrow: 'Le guide',
  guideTitre: 'Tout ce qu’il faut pour ta <em class="accent">fin de cycle</em>',
  guideLangue: '',
  recTitre: 'Et une cuisine de fin de cycle, <em class="signature">vraiment simple</em>',
  recTexte: `${recettes.length} recettes rapides et rassasiantes, du banana bread au lait d’or.`,
  pqEyebrow: 'Pour qui',
  pqTitre: 'Ce guide est fait <em class="accent">pour toi</em> si…',
  oui: 'Oui, c’est toi', non: 'Pas pour toi si',
  pourToi: [
    'Ta fin de cycle t’épuise, physiquement ou émotionnellement',
    'Tu fais déjà attention, mais rien ne change vraiment',
    'Tu veux comprendre, pas seulement tenir',
    'Tu cherches du concret, pas des généralités',
    'Tu es prête à adapter ton rythme à ton cycle',
  ],
  pasPourToi: [
    'Tu cherches un diagnostic ou un traitement',
    'Tu attends une solution miracle sans rien changer',
    'Tu ne ressens rien de particulier en fin de cycle',
    'Tu cherches un régime ou un programme de sport',
  ],
  offreEyebrow: 'L’offre',
  offreTitre: 'Cycle Awakening, <em class="accent">le guide</em>',
  offreIntro: 'Comprendre, nourrir, bouger, ralentir : la méthode pour traverser ta phase lutéale sans te perdre.',
  modalite: 'Paiement unique',
  contenu: [
    `${chapitres.length} chapitres, de la compréhension à la semaine type J17–J28`,
    `${recettes.length} recettes simples, rapides et rassasiantes`,
    `${outils.length} outils à imprimer : ${nomsOutils.join(', ')}`,
    'Une version A4 et une version pour téléphone et liseuse',
    'Un livre digital à télécharger et à garder',
  ],
  faqEyebrow: 'Questions',
  faqTitre: 'Tes <em class="accent">questions</em>',
  faq: [
    { q: 'C’est quoi exactement, ce guide ?', r: `Un livre digital${pages ? ` de ${pages} pages` : ''} pour comprendre ta phase lutéale (J17 à J28) et t’organiser avec elle : des repères concrets pour manger, bouger et ralentir, une semaine type, ${recettes.length} recettes et des outils à imprimer.` },
    { q: 'Je n’ai pas de diagnostic de SPM, c’est pour moi ?', r: 'Si tu remarques des changements physiques ou émotionnels en fin de cycle, oui. Pas besoin de diagnostic : le guide parle de tendances et de repères de mode de vie.' },
    { q: 'Comment je reçois le guide ?', r: 'Après le paiement, tu reçois un email avec ton lien de téléchargement. Le livre digital est à toi : tu le gardes et tu le rouvres à chaque fin de cycle.' },
    { q: 'Est-ce que ça remplace un suivi médical ?', r: 'Non. Cycle Awakening propose un accompagnement de mode de vie. Douleur intense, saignements très abondants, symptômes nouveaux ou qui s’aggravent, humeur très basse : parles-en à ta sage-femme, ton ou ta gynécologue, ton médecin ou un·e psychologue.' },
    { q: 'Mes cycles ne font pas 28 jours. Ça marche quand même ?', r: 'Oui. J17–J28 est un repère pour un cycle moyen. Le guide t’apprend à repérer tes propres signaux pour caler les conseils sur ton cycle à toi.' },
    { q: 'Et si je veux aller plus loin ensuite ?', r: 'La newsletter t’envoie chaque semaine un repère et une recette. Un accompagnement personnalisé est en préparation : les inscrites seront prévenues en premier.' },
  ],
  nlEyebrow: 'La newsletter',
  nlTitre: 'Chaque semaine, un repère <em class="accent">pour ta phase</em>',
  nlPlus: ['Un repère simple selon le moment de ton cycle', 'Une nouvelle recette de saison', 'Les nouveautés de Cycle Awakening en avant-première'],
  nlNote: 'Tu recevras un email pour confirmer ton inscription. Pas de spam, jamais.',
};

const enTx: typeof fr = {
  description: 'Understand your luteal phase (day 17 to day 28) and organise your life around it: eating, moving, slowing down. A practical guide, without guilt.',
  heroEyebrow: 'The guide to the end of your cycle · D17–D28',
  heroL1: 'You are not', heroL2: 'unstable.', heroL3: 'You are cyclical.',
  heroLead: 'Fatigue, irritability, bloating, wanting to disappear for a few days every month: your luteal phase has a logic. Understand it, and work with it, not against it.',
  heroLien: 'Discover the guide',
  faitsAria: 'The guide in numbers',
  faits: [
    { chiffre: String(chapitres.length), libelle: 'chapters to understand and act' },
    { chiffre: String(recettes.length), libelle: 'simple end-of-cycle recipes' },
    { chiffre: String(outils.length), libelle: 'printable tools, including a bonus' },
    { chiffre: '0', libelle: 'diets, 0 calories counted' },
  ],
  phrases: ['You are not unstable. You are cyclical.', 'Slowing down is a hormonal strategy.', 'Understand before you change.', 'Come back to yourself. Every month.'],
  probEyebrow: 'The problem',
  probTitre: 'Does this <em class="accent">sound like you</em>?',
  probChute: 'It’s not in your head. It’s not a lack of willpower. It’s a phase of your cycle, with its own rules.',
  reconnais: [
    'I don’t understand why I turn into someone else before my period.',
    'I eat well, I exercise. And yet, every month, I fall apart.',
    'I feel like I lose who I am for seven to ten days.',
    'I’m tired of trying everything without understanding what’s really going on.',
    'The advice is either too medical or too vague.',
  ],
  guillemets: ['“', '”'],
  cycleEyebrow: 'Understand first',
  cycleTitre: 'Your cycle in <em class="accent">four phases</em>',
  histEyebrow: 'My story',
  histTitre: 'The problem is not your <em class="accent">discipline.</em>',
  histTexte: 'For years, I lived exactly this: disappearing for a few days every month without understanding why. I searched, tested, and brought together nutrition, movement and an understanding of the cycle. This guide is the one I wish I had found: <em>simple, practical, guilt-free.</em>',
  portraitAlt: 'Emeline, founder of Cycle Awakening',
  role: 'Founder of Cycle Awakening',
  livreTitre: 'The Guide',
  livreSous: 'Understanding and getting through your luteal phase,<br />D17–D28',
  guideEyebrow: 'The guide',
  guideTitre: 'Everything you need for the <em class="accent">end of your cycle</em>',
  guideLangue: 'The guide is written in French. The English edition is in preparation: subscribe to the newsletter to be the first to know.',
  recTitre: 'And an end-of-cycle kitchen, <em class="signature">truly simple</em>',
  recTexte: `${recettes.length} quick, filling recipes, from banana bread to golden milk.`,
  pqEyebrow: 'Who it’s for',
  pqTitre: 'This guide is <em class="accent">for you</em> if…',
  oui: 'Yes, that’s you', non: 'Not for you if',
  pourToi: [
    'The end of your cycle wears you out, physically or emotionally',
    'You already take care of yourself, but nothing really changes',
    'You want to understand, not just get through it',
    'You want practical steps, not generalities',
    'You’re ready to adapt your pace to your cycle',
  ],
  pasPourToi: [
    'You’re looking for a diagnosis or a treatment',
    'You expect a miracle solution without changing anything',
    'You don’t feel anything particular at the end of your cycle',
    'You’re looking for a diet or a workout programme',
  ],
  offreEyebrow: 'The offer',
  offreTitre: 'Cycle Awakening, <em class="accent">the guide</em>',
  offreIntro: 'Understand, nourish, move, slow down: the method to get through your luteal phase without losing yourself.',
  modalite: 'One-time payment',
  contenu: [
    `${chapitres.length} chapters, from understanding to a typical week, D17–D28`,
    `${recettes.length} simple, quick and filling recipes`,
    `${outils.length} printable tools: ${nomsOutils.join(', ')}`,
    'An A4 version and a version for phones and e-readers',
    'A digital book to download and keep',
  ],
  faqEyebrow: 'Questions',
  faqTitre: 'Your <em class="accent">questions</em>',
  faq: [
    { q: 'What exactly is this guide?', r: `A digital book${pages ? ` of ${pages} pages` : ''} to understand your luteal phase (day 17 to day 28) and organise your life around it: practical markers for eating, moving and slowing down, a typical week, ${recettes.length} recipes and printable tools.` },
    { q: 'Is the guide available in English?', r: 'The guide is currently written in French. An English edition is in preparation: newsletter subscribers will be told first.' },
    { q: 'I don’t have a PMS diagnosis. Is it for me?', r: 'If you notice physical or emotional changes at the end of your cycle, yes. No diagnosis needed: the guide talks about tendencies and lifestyle markers.' },
    { q: 'How do I receive the guide?', r: 'After payment, you receive an email with your download link. The digital book is yours: you keep it and come back to it at the end of every cycle.' },
    { q: 'Does it replace medical care?', r: 'No. Cycle Awakening offers lifestyle support. Intense pain, very heavy bleeding, new or worsening symptoms, very low mood: talk to your midwife, your gynaecologist, your doctor or a psychologist.' },
    { q: 'My cycles aren’t 28 days long. Does it still work?', r: 'Yes. D17–D28 is a marker for an average cycle. The guide teaches you to spot your own signals so you can match the advice to your own cycle.' },
    { q: 'What if I want to go further?', r: 'The newsletter sends you a marker and a recipe every week. Personalised support is in preparation: subscribers will be told first.' },
  ],
  nlEyebrow: 'The newsletter',
  nlTitre: 'Every week, a marker <em class="accent">for your phase</em>',
  nlPlus: ['A simple marker for where you are in your cycle', 'A new seasonal recipe', 'Cycle Awakening news, before anyone else'],
  nlNote: 'You’ll receive an email to confirm your subscription. No spam, ever.',
};
const tx = en ? enTx : fr;
---

<PageLayout headerOverlay description={tx.description}>
  <!-- HERO -->
  <section class="hero deep grain" data-hero data-spotlight>
    <div class="aurora" aria-hidden="true">
      <span class="aurora__blob aurora__blob--1" data-depth="-40"></span>
      <span class="aurora__blob aurora__blob--2" data-depth="30"></span>
      <span class="aurora__blob aurora__blob--3" data-depth="-20"></span>
    </div>
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__in" style="--d: 0" data-in>{tx.heroEyebrow}</p>
        <h1 class="hero__title">
          <span class="ligne"><span class="hero__line" style="--d: 1" data-in>{tx.heroL1}</span></span>
          <span class="ligne"><span class="hero__line" style="--d: 2" data-in>{tx.heroL2}</span></span>
          <span class="ligne"><em class="accent hero__line" style="--d: 3" data-in>{tx.heroL3}</em></span>
        </h1>
        <p class="hero__lead hero__in" style="--d: 4" data-in>{tx.heroLead}</p>
        <div class="hero__ctas hero__in" style="--d: 5" data-magnetic data-in>
          <Cta location="hero" variant="on-deep" />
          <a class="hero__link" href="#guide">{tx.heroLien} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__disque" data-depth="18" data-hero-disque><CycleWheel /></div>
      </div>
    </div>
    <div class="hero__bandeau"><Marquee phrases={tx.phrases} /></div>
  </section>

  <!-- FAITS (vrais, issus du livre) : panneau opaque posé à cheval sur le bas du hero -->
  <section class="faits" aria-label={tx.faitsAria}>
    <div class="container">
      <div class="faits__verre">
        {tx.faits.map((f) => (
          <div class="fait">
            <span class="fait__chiffre" data-count={f.chiffre}>{f.chiffre}</span>
            <span class="fait__libelle">{f.libelle}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROBLÈME -->
  <section class="section probleme" id="probleme">
    <div class="container probleme__grid">
      <div class="probleme__titre">
        <p class="eyebrow">{tx.probEyebrow}</p>
        <h2 data-split set:html={tx.probTitre} />
        <p class="probleme__chute" data-reveal>{tx.probChute}</p>
      </div>
      <ol class="probleme__liste" data-stack>
        {tx.reconnais.map((r, i) => (
          <li class="citation glass" style={`--i: ${i}`}>
            <span class="citation__num">0{i + 1}</span>
            <p>{tx.guillemets[0]}{r}{tx.guillemets[1]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TON CYCLE -->
  <section class="deep grain cycle" id="cycle" data-clip data-spotlight>
    <div class="container cycle__inner" data-pin-cycle>
      <p class="eyebrow">{tx.cycleEyebrow}</p>
      <h2 class="cycle__titre" data-split set:html={tx.cycleTitre} />
      <CyclePhases />
    </div>
  </section>

  <!-- HISTOIRE : typographique, le texte s'allume mot à mot au défilement -->
  <section class="section histoire">
    <div class="container">
      <p class="eyebrow">{tx.histEyebrow}</p>
      <h2 class="histoire__titre" data-split set:html={tx.histTitre} />
      <p class="histoire__texte" data-words set:html={tx.histTexte} />
      <div class="histoire__signature" data-reveal>
        {portrait && <img class="histoire__portrait" src={portrait} alt={tx.portraitAlt} width="160" height="160" loading="lazy" />}
        <p><span class="histoire__nom">Emeline</span><span class="histoire__role">{tx.role}</span></p>
      </div>
    </div>
  </section>

  <!-- LE GUIDE -->
  <section class="section sage guide" id="guide">
    <div class="container guide__grid">
      <div class="livre">
        <div class="livre__objet" data-book>
          <div class="livre__couverture">
            <img src="/brand/logo-clair.svg" alt="" class="livre__logo" />
            <p class="livre__titre">{tx.livreTitre}</p>
            <p class="livre__sous" set:html={tx.livreSous} />
            <span class="livre__filet"></span>
          </div>
          <div class="livre__tranche" aria-hidden="true"></div>
        </div>
      </div>
      <div>
        <p class="eyebrow">{tx.guideEyebrow}</p>
        <h2 data-split set:html={tx.guideTitre} />
        {tx.guideLangue && <p class="guide__langue">{tx.guideLangue}</p>}
        <ol class="chapitres glass">
          {chap.map((c) => (
            <li class="chapitre" data-reveal>
              <span class="chapitre__num">{String(c.ordre).padStart(2, '0')}</span>
              <span>
                <span class="chapitre__titre">{c.titre}</span>
                <span class="chapitre__accroche">{c.accroche}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="container recettes">
      <div class="recettes__entete">
        <h3 set:html={tx.recTitre} />
        <p>{tx.recTexte}</p>
      </div>
      <ul class="recettes__grille">
        {vitrine.map((r, i) => (
          <li class="recette" data-speed={[0.06, 0.16, 0.04, 0.12][i]}>
            <img src={photosRecettes[r.photo]} alt={r.titre} loading="lazy" decoding="async" />
            <span class="recette__legende glass-deep">
              <span class="recette__nom">{r.nom}</span>
              <span class="recette__temps">{r.temps}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- POUR QUI -->
  <section class="section pourqui">
    <div class="container">
      <p class="eyebrow">{tx.pqEyebrow}</p>
      <h2 data-split set:html={tx.pqTitre} />
      <div class="pourqui__grid">
        <ul class="liste liste--oui" data-reveal>
          <li class="liste__titre">{tx.oui}</li>
          {tx.pourToi.map((l) => <li>{l}</li>)}
        </ul>
        <ul class="liste liste--non glass" data-reveal>
          <li class="liste__titre">{tx.non}</li>
          {tx.pasPourToi.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- OFFRE -->
  <section class="section deep grain offre" id="offre" data-clip data-spotlight>
    <div class="aurora aurora--offre" aria-hidden="true"><span class="aurora__blob aurora__blob--1"></span><span class="aurora__blob aurora__blob--2"></span></div>
    <div class="container offre__grid">
      <div>
        <p class="eyebrow">{tx.offreEyebrow}</p>
        <h2 data-split set:html={tx.offreTitre} />
        <p class="offre__intro">{tx.offreIntro}</p>
      </div>
      <div class="offre__carte" data-reveal data-magnetic>
        <p class="offre__prix">{prix}</p>
        <p class="offre__modalite">{tx.modalite}</p>
        <ul class="offre__liste">
          {tx.contenu.map((c) => <li>{c}</li>)}
        </ul>
        <Cta location="offre" variant="on-deep" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container faq__grid">
      <div>
        <p class="eyebrow">{tx.faqEyebrow}</p>
        <h2 data-split set:html={tx.faqTitre} />
      </div>
      <div class="faq__liste">
        {tx.faq.map((f) => (
          <details class="faq__item glass" data-faq-card>
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="section sage newsletter" id="newsletter">
    <div class="container newsletter__grid">
      <div>
        <p class="eyebrow">{tx.nlEyebrow}</p>
        <h2 data-split set:html={tx.nlTitre} />
        <ul class="newsletter__plus">
          {tx.nlPlus.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <div class="newsletter__form glass" data-reveal>
        <NewsletterForm source="home" />
        <p class="newsletter__note">{tx.nlNote}</p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .guide__langue { font-size: var(--font-size-sm); color: var(--semantic-text-muted); max-width: 34rem; margin-top: calc(-1 * var(--space-2)); }
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; min-height: 100svh; display: flex; align-items: center; padding-block: calc(var(--space-16) + 4rem) calc(var(--space-16) + 11rem); }
  /* Bandeau des phrases : fondu dans le bas du hero, juste au-dessus du panneau des chiffres. */
  .hero__bandeau { position: absolute; left: 0; right: 0; bottom: 7rem; z-index: 1; }
  .hero__grid { position: relative; display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 60rem) { .hero__grid { grid-template-columns: 1.15fr 1fr; } }
  .hero__title { font-size: clamp(3.1rem, 1.6rem + 6.4vw, 7.4rem); line-height: 0.95; letter-spacing: -0.02em; margin-bottom: var(--space-8); }
  .hero__title .ligne { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
