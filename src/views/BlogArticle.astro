---
// Page article. Structure imposée par le skill seo-blog : réponse immédiate, intertitres-questions,
// actions concrètes, encadré « Quand consulter », mention médicale, sources, maillage interne.
// Utilisée par /blog/[slug] (français) et /en/blog/[slug] (anglais).
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Cta from '../components/Cta.astro';
import { SITE_URL } from '../config/site';
import { article as articleLd, fil } from '../config/seo';
import sharp from 'sharp';
import { piliers, tempsDeLecture, slugOf, urlOf, equivalents, type Article } from '../data/blog';
import { langOf, formatDate, path, ancre, intlLocale } from '../i18n';

interface Props { article: Article; tous: Article[] }
const { article, tous } = Astro.props;
const lang = langOf(Astro.url);
const en = lang === 'en';
const { data } = article;
const { Content } = await render(article);
const date = (d: Date) => formatDate(d, lang);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const brouillon = data.statut !== 'publie';
const voisins = tous.filter((a) => a.id !== article.id && a.data.pillar === data.pillar).slice(0, 3);
const url = `${SITE_URL}${urlOf(article)}`;
const alternate = await equivalents(article);
const tx = en
  ? {
      par: 'By', relu: 'reviewed by', maj: 'updated on', lecture: 'min read',
      brouillon: (s: string) => `Draft (${s}): not published, not indexed, to be reviewed and approved. Sources marked “to check” must be confirmed before publication.`,
      filAria: 'Breadcrumb', accueil: 'Home', blog: 'Blog',
      consulter: 'When to see someone',
      consulterTexte: 'Talk to your midwife, your gynaecologist, your doctor, or a psychologist for your mood. In an emergency: call 15 in France, or your local emergency number.',
      avertissement: 'This content offers lifestyle markers. It does not replace medical advice, a diagnosis or treatment.',
      sources: 'Sources', aVerifier: ' · to check', voisins: 'Read next',
      suiteTitre: 'Every week, a marker <em class="accent">for your phase</em>',
      suiteTexte: 'A short email, a recipe, nothing else.',
      suiteGuide: 'Want the whole path, from D17 to D28?', decouvrir: 'Discover the guide',
    }
  : {
      par: 'Par', relu: 'relu par', maj: 'mis à jour le', lecture: 'min de lecture',
      brouillon: (s: string) => `Brouillon (${s}) : non publié, non indexé, à relire et valider. Les sources marquées « à vérifier » doivent être confirmées avant publication.`,
      filAria: 'Fil d’Ariane', accueil: 'Accueil', blog: 'Blog',
      consulter: 'Quand consulter',
      consulterTexte: 'Parles-en à ta sage-femme, ton ou ta gynécologue, ton médecin, ou à un·e psychologue pour le moral. En cas d’urgence : le 15.',
      avertissement: 'Ce contenu propose des repères de mode de vie. Il ne remplace pas un avis médical, un diagnostic ou un traitement.',
      sources: 'Sources', aVerifier: ' · à vérifier', voisins: 'À lire aussi',
      suiteTitre: 'Chaque semaine, un repère <em class="accent">pour ta phase</em>',
      suiteTexte: 'Un email court, une recette, rien d’autre.',
      suiteGuide: 'Tu veux tout le chemin, de J17 à J28 ?', decouvrir: 'Découvrir le guide',
    };

// SEO : titre Google (≤ 60), image de partage dédiée, données structurées, variantes de la photo d'en-tête (LCP).
const ogId = `${lang === 'en' ? 'en-' : ''}${slugOf(article)}`;
const imageDePartage = data.image ?? (data.photo ? `/images/share/blog/${ogId}.jpg` : '/images/share/og-default.png');
const base = data.photo?.replace(/\.webp$/, '');
let srcset: string | undefined;
if (base) {
  const { width } = await sharp(`public/images/blog/${data.photo}`).metadata();
  srcset = `/images/blog/${base}-640.webp 640w, /images/blog/${base}-960.webp 960w, /images/blog/${data.photo} ${width}w`;
}
const dansLangue = (u: string) => new URL(u, SITE_URL).toString();
const jsonLd = [
  articleLd({
    url,
    titre: data.title,
    description: data.description,
    images: [dansLangue(imageDePartage), ...(data.photo ? [dansLangue(`/images/blog/${data.photo}`)] : [])],
    publie: iso(data.publishedAt),
    modifie: iso(data.updatedAt),
    lang,
    motsCles: data.keywords,
    rubrique: piliers[lang][data.pillar],
    mots: (article.body ?? '').split(/\s+/).filter(Boolean).length,
    relu: data.reviewedBy,
    sources: data.sources.map((s) => ({ nom: s.label, url: s.url })),
  }),
  fil([
    { nom: tx.accueil, url: path('accueil', lang) },
    { nom: tx.blog, url: path('blog', lang) },
    { nom: data.title, url },
  ]),
];
---

<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  type="article"
  image={imageDePartage}
  imageAlt={data.imageAlt ?? data.photoAlt ?? data.title}
  noindex={brouillon}
  alternate={alternate}
  jsonLd={jsonLd}
  preload={data.photo ? { href: `/images/blog/${data.photo}`, srcset, sizes: '(max-width: 52rem) 100vw, 62vw' } : undefined}
  article={{ publie: iso(data.publishedAt), modifie: iso(data.updatedAt), auteur: data.author, rubrique: piliers[lang][data.pillar], tags: data.keywords }}
>
  <PageHero
    eyebrow={piliers[lang][data.pillar]}
    title={data.title}
    lead={data.description}
    photo={data.photo ? `/images/blog/${data.photo}` : undefined}
    photoAlt={data.photoAlt}
    photoSrcset={srcset}
    credit={data.photoCredit}
    photoAttendue={brouillon && !data.photo}
  >
    <p class="meta">
      {tx.par} <strong>{data.author}</strong>{data.reviewedBy && <> · {tx.relu} {data.reviewedBy}</>} ·
      <time datetime={iso(data.publishedAt)}>{date(data.publishedAt)}</time>
      {iso(data.updatedAt) !== iso(data.publishedAt) && <> · {tx.maj} <time datetime={iso(data.updatedAt)}>{date(data.updatedAt)}</time></>}
      · {tempsDeLecture(article.body ?? '')} {tx.lecture}
    </p>
  </PageHero>

  <article class="section">
    <div class="container article">
      {brouillon && (
        <p class="todo" role="note">{tx.brouillon(data.statut)}</p>
      )}
      <nav class="fil" aria-label={tx.filAria}><a href={path('accueil', lang)}>{tx.accueil}</a> › <a href={path('blog', lang)}>{tx.blog}</a> › <span>{data.title}</span></nav>


      <div class="prose glass">
        <Content />

        <aside class="consulter" aria-labelledby="consulter-titre">
          <p class="consulter__titre" id="consulter-titre">{tx.consulter}</p>
          <ul>{data.consulter.map((c) => <li>{c}</li>)}</ul>
          <p>{tx.consulterTexte}</p>
        </aside>

        <p class="avertissement">{tx.avertissement}</p>

        {data.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-titre">
            <h2 id="sources-titre">{tx.sources}</h2>
            <ol>
              {data.sources.map((s) => (
                <li>
                  {s.url ? <a href={s.url} rel="noopener">{s.label}</a> : s.label}
                  {!s.verifie && <span class="a-verifier">{tx.aVerifier}</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      {voisins.length > 0 && (
        <section class="voisins" aria-labelledby="voisins-titre">
          <h2 id="voisins-titre">{tx.voisins}</h2>
          <ul>
            {voisins.map((v) => <li class="glass"><a href={urlOf(v)}><span>{v.data.title}</span></a></li>)}
          </ul>
        </section>
      )}

      <section class="suite deep grain" aria-labelledby="suite-titre">
        <h2 id="suite-titre" set:html={tx.suiteTitre} />
        <p>{tx.suiteTexte}</p>
        <NewsletterForm source={`blog-${slugOf(article)}`} variant="deep" />
        <p class="suite__guide">{tx.suiteGuide} <Cta location={`blog-${slugOf(article)}`} variant="on-deep" label={tx.decouvrir} fallbackHref={ancre('guide', lang)} /></p>
      </section>
    </div>
  </article>
</PageLayout>

<style>
  .meta { color: var(--semantic-text-on-deep-muted); font-size: var(--font-size-sm); margin-top: var(--space-4); }
  .meta strong { color: var(--semantic-text-on-deep); font-weight: var(--font-weight-medium); }
  .article { max-width: calc(46rem + 2 * var(--space-gutter)); }
  .fil { font-size: var(--font-size-xs); color: var(--semantic-text-muted); margin-bottom: var(--space-6); }
  .prose { padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); font-size: 1.0625rem; line-height: 1.75; color: var(--semantic-text-reading); }
  .prose :global(h2) { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem); margin-top: var(--space-12); color: var(--semantic-text); }
  .prose :global(h3) { font-size: var(--font-size-xl); margin-top: var(--space-8); }
  .prose :global(p), .prose :global(li) { max-width: 68ch; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(strong) { color: var(--semantic-text); }
  .prose :global(blockquote) { margin: var(--space-8) 0; padding-left: var(--space-6); border-left: 2px solid var(--semantic-accent); font-family: var(--font-family-display); font-style: italic; font-size: var(--font-size-xl); color: var(--semantic-text); }
  .prose :global(a) { color: var(--semantic-accent-text); font-weight: var(--font-weight-medium); }
  .consulter { margin-top: var(--space-12); padding: var(--space-6); border-radius: 20px; background: var(--semantic-bg-accent-soft); border-left: 4px solid var(--semantic-accent-text); }
  .consulter__titre { font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); letter-spacing: 0.14em; text-transform: uppercase; color: var(--semantic-accent-text); margin-bottom: var(--space-3); }
  .avertissement { font-size: var(--font-size-sm); color: var(--semantic-text-muted); margin-top: var(--space-6); }
  .sources { margin-top: var(--space-8); font-size: var(--font-size-sm); }
  .sources h2 { font-size: var(--font-size-lg); margin-top: 0; }
  .a-verifier { color: var(--semantic-accent-text); font-weight: var(--font-weight-semibold); }
  .voisins { margin-top: var(--space-12); }
  .voisins h2 { font-size: var(--font-size-xl); }
  .voisins ul { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .voisins a { display: block; padding: var(--space-4) var(--space-6); color: var(--semantic-text); text-decoration: none; font-family: var(--font-family-display); font-size: var(--font-size-lg); }
  .suite { margin-top: var(--space-12); padding: clamp(1.5rem, 1rem + 3vw, 3rem); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -40px rgb(18 34 25 / 0.6); }
  .suite h2 { font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem); }
  .suite__guide { margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; color: var(--semantic-text-on-deep-muted); }
</style>
