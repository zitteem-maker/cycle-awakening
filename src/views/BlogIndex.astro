---
// Liste des articles du blog, en français (/blog) et en anglais (/en/blog). En production : seulement les articles « publie ».
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { articles, piliers, tempsDeLecture, afficherBrouillons, urlOf } from '../data/blog';
import { langOf, formatDate, path } from '../i18n';
import { collection, fil } from '../config/seo';

const lang = langOf(Astro.url);
const liste = await articles(lang);
const date = (d: Date) => formatDate(d, lang);
const tx = lang === 'en'
  ? {
      title: 'Blog: understand your cycle, phase by phase',
      description: 'Understand your cycle, phase by phase: practical markers for eating, moving and slowing down, with no diet and no miracle promises.',
      rss: 'Cycle Awakening — the blog', rssHref: '/en/blog/rss.xml',
      eyebrow: 'The blog', hero: 'Understand your cycle, <em class="accent">phase by phase</em>',
      lead: 'Practical markers, no jargon, no guilt. What science says, and what everyday life asks of you.',
      apercu: 'Preview: drafts are shown. In production, only approved articles appear.',
      videTitre: 'The first articles are coming <em class="accent">very soon</em>',
      videTexte: 'Subscribe to the newsletter to get them as soon as they’re out, with a simple marker for your phase.',
      statut: { brouillon: 'draft', relu: 'reviewed', publie: 'published' },
    }
  : {
      title: 'Blog : comprendre son cycle, phase par phase',
      description: 'Comprendre ton cycle, phase après phase : des repères concrets pour manger, bouger et ralentir, sans régime ni promesse miracle.',
      rss: 'Cycle Awakening — le blog', rssHref: '/blog/rss.xml',
      eyebrow: 'Le blog', hero: 'Comprendre ton cycle, <em class="accent">phase après phase</em>',
      lead: 'Des repères concrets, sans jargon, sans culpabilité. Ce que la science dit, ce que le quotidien demande.',
      apercu: 'Prévisualisation : les brouillons sont affichés. En production, seuls les articles validés apparaissent.',
      videTitre: 'Les premiers articles arrivent <em class="accent">très bientôt</em>',
      videTexte: 'Inscris-toi à la newsletter pour les recevoir dès leur sortie, avec un repère simple pour ta phase.',
      statut: { brouillon: 'brouillon', relu: 'relu', publie: 'publie' },
    };
---

<PageLayout
  title={tx.title}
  description={tx.description}
  jsonLd={[
    collection({ nom: tx.eyebrow, description: tx.description, url: path('blog', lang), lang, elements: liste.map((a) => ({ nom: a.data.title, url: urlOf(a) })) }),
    fil([{ nom: lang === 'en' ? 'Home' : 'Accueil', url: path('accueil', lang) }, { nom: tx.eyebrow, url: path('blog', lang) }]),
  ]}
>
  <PageHero eyebrow={tx.eyebrow} title={tx.hero} lead={tx.lead} />

  <section class="section">
    <div class="container">
      {afficherBrouillons && <p class="todo">{tx.apercu}</p>}
      {liste.length === 0 ? (
        <div class="vide glass">
          <h2 set:html={tx.videTitre} />
          <p>{tx.videTexte}</p>
          <NewsletterForm source="blog" />
        </div>
      ) : (
        <ul class="grille">
          {liste.map((a, i) => (
            <li class:list={['carte glass', { 'carte--pilier': a.data.type === 'pilier' }]} data-reveal style={`--d: ${i % 3}`}>
              <a href={urlOf(a)}>
                <p class="carte__meta">
                  <span>{piliers[lang][a.data.pillar]}</span>
                  <span>{tempsDeLecture(a.body ?? '')} min</span>
                  {a.data.statut !== 'publie' && <span class="carte__statut">{tx.statut[a.data.statut]}</span>}
                </p>
                <h2 class="carte__titre">{a.data.title}</h2>
                <p class="carte__desc">{a.data.description}</p>
                <p class="carte__date">{date(a.data.publishedAt)}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</PageLayout>

<style>
  .grille { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); }
  @media (min-width: 52rem) { .grille { grid-template-columns: repeat(2, 1fr); } .carte--pilier { grid-column: 1 / -1; } }
  .carte { transition: transform var(--motion-duration-base) var(--motion-ease), box-shadow var(--motion-duration-base) var(--motion-ease); }
  .carte:hover { transform: translateY(-4px); }
  .carte a { display: block; height: 100%; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); color: inherit; text-decoration: none; }
  .carte__meta { display: flex; flex-wrap: wrap; gap: var(--space-4); font-size: var(--font-size-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--semantic-text-muted); }
  .carte__statut { color: var(--semantic-accent-text); }
  .carte__titre { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.3rem); margin-bottom: var(--space-4); }
  .carte--pilier .carte__titre { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); }
  .carte__desc { color: var(--semantic-text-muted); }
  .carte__date { font-size: var(--font-size-xs); color: var(--semantic-text-muted); margin: 0; }
  .vide { padding: clamp(1.5rem, 1rem + 3vw, 3.5rem); max-width: 46rem; }
</style>
