---
// Gabarit commun : métadonnées SEO, Open Graph / Twitter, favicon, polices préchargées.
import '../styles/global.css';
import { SITE_URL, site } from '../config/site';
import { langOf, alternates, cleanPath, htmlLang, ogLocale, t, type Lang } from '../i18n';
import { limites } from '../config/seo';
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import cormorantMedium from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Chemin d'une image de partage 1200×630 dans /public. Par défaut l'image générique. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'product';
  /** true pour les pages à ne pas indexer (merci, téléchargement, guide de style…). */
  noindex?: boolean;
  /** Équivalent de la page dans l'autre langue, pour les pages hors table de routes (articles). */
  alternate?: Partial<Record<Lang, string | null>>;
  /** Données structurées (JSON-LD) propres à la page. */
  jsonLd?: object[];
  /** Image principale à précharger (LCP), avec ses variantes de largeur. */
  preload?: { href: string; srcset?: string; sizes?: string };
  /** Métadonnées d'article (Open Graph « article »). */
  article?: { publie: string; modifie: string; auteur: string; rubrique: string; tags: string[] };
}

const lang = langOf(Astro.url);
const tx = t(lang);
const {
  title,
  description = tx.description,
  image = site.shareImage,
  imageAlt = tx.shareAlt,
  type = 'website',
  noindex = false,
  alternate,
  jsonLd = [],
  preload,
  article,
} = Astro.props;

// Titre : « Titre · Cycle Awakening » tant que ça tient en 60 caractères (au-delà, Google le coupe) ; sinon le titre seul.
const avecMarque = title ? (title.includes(site.name) ? title : `${title} · ${site.name}`) : '';
const fullTitle = title ? (avecMarque.length <= limites.titre ? avecMarque : title) : `${site.name} — ${tx.tagline}`;
const rss = lang === 'en' ? { href: '/en/blog/rss.xml', titre: 'Cycle Awakening — the blog' } : { href: '/blog/rss.xml', titre: 'Cycle Awakening — le blog' };
// L'URL canonique n'a ni « .html » ni « index ».
const canonical = new URL(cleanPath(Astro.url), SITE_URL).toString();
const alt = alternates(Astro.url, alternate);
const hreflang = noindex ? [] : (Object.entries(alt).filter(([, u]) => u) as [Lang, string][]);
const imageUrl = new URL(image, SITE_URL).toString();
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    <link rel="alternate" type="application/rss+xml" title={rss.titre} href={rss.href} />
    {hreflang.map(([l, u]) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(u, SITE_URL).toString()} />)}
    {hreflang.length > 1 && alt.fr && <link rel="alternate" hreflang="x-default" href={new URL(alt.fr, SITE_URL).toString()} />}

    {preload && <link rel="preload" as="image" href={preload.href} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantMedium} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F7F4EF" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'fr' ? 'en' : 'fr']} />
    <meta property="og:type" content={type} />
    {article && <meta property="article:published_time" content={article.publie} />}
    {article && <meta property="article:modified_time" content={article.modifie} />}
    {article && <meta property="article:author" content={article.auteur} />}
    {article && <meta property="article:section" content={article.rubrique} />}
    {article && article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      // Animations avancées : on masque les éléments d'entrée avant le premier affichage (pas de clignotement).
      // Filet de sécurité : si les animations ne démarrent pas dans les 3 s, tout redevient visible.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var h = document.documentElement;
        h.classList.add('js-motion');
        setTimeout(function () { if (!h.classList.contains('motion')) h.classList.remove('js-motion'); }, 3000);
      }
    </script>
    {jsonLd.map((bloc) => <script type="application/ld+json" set:html={JSON.stringify(bloc)} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="fond-site" aria-hidden="true"><span></span><span></span><span></span></div>
    <a class="skip-link" href="#contenu">{tx.skip}</a>
    <slot />
    <script>
      import '../scripts/motion';
      import '../scripts/mesure';
      import '../scripts/devise';
    </script>
    <script>
      // Apparition douce des blocs [data-reveal] quand ils entrent à l'écran (une seule fois).
      // Sans JavaScript ou en mouvement réduit, tout reste visible.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-on');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
