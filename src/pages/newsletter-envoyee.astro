---
// Après l'envoi du formulaire sans JavaScript. Non indexée.
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<PageLayout title="Vérifie tes emails" description="Confirme ton inscription à la newsletter." noindex headerCta={false}>
  <PageHero size="page" eyebrow="Newsletter" title={'Presque fini. <em class="accent">Regarde tes emails.</em>'} lead="Je viens de t’envoyer un email de confirmation. Clique sur le lien qu’il contient pour valider ton inscription. Rien reçu ? Regarde dans les spams ou l’onglet « Promotions ».">
    <p class="retour"><a class="glass-deep retour__lien" href="/">Retour à l’accueil</a></p>
  </PageHero>
</PageLayout>

<style>
  .retour { margin-top: var(--space-8); }
  .retour__lien { display: inline-flex; align-items: center; min-height: var(--size-tap-target); padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); text-decoration: none; }
</style>
