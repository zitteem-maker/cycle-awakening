---
// Page d'accueil (étape 3). Structure : hero, bandeau, faits, problème, cycle, histoire, guide, pour qui, offre, FAQ, newsletter.
// Règles : aucun chiffre ni témoignage inventé (les faits viennent du vrai livre), aucune promesse de résultat.
import PageLayout from '../layouts/PageLayout.astro';
import Cta from '../components/Cta.astro';
import CycleWheel from '../components/home/CycleWheel.astro';
import Marquee from '../components/home/Marquee.astro';
import CyclePhases from '../components/home/CyclePhases.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { guide, formatPrice } from '../config/offers';
import { chapitres, recettes, outils } from '../data/livre';

const prix = formatPrice(guide.priceCents);
const pages = guide.pages;
const photosRecettes: Record<string, string> = {
  'banana-bread.jpg': '/images/site/banana-bread.webp',
  'cookies-pois-chiches.jpg': '/images/site/cookies.webp',
  'dorade-fenouil.jpg': '/images/site/poisson-fenouil.webp',
  'lait-dor-chai.jpg': '/images/site/lait-dor.webp',
};
const vitrine = recettes.filter((r) => photosRecettes[r.photo]).slice(0, 4);

const faits = [
  { chiffre: String(chapitres.length), libelle: 'chapitres pour comprendre et agir' },
  { chiffre: String(recettes.length), libelle: 'recettes simples de fin de cycle' },
  { chiffre: String(outils.length), libelle: 'outils à imprimer, dont un bonus' },
  { chiffre: '0', libelle: 'régime, 0 calorie comptée' },
];

const phrases = [
  'Tu n’es pas instable. Tu es cyclique.',
  'Ralentir est une stratégie hormonale.',
  'Comprendre avant de changer.',
  'Redevenir toi. Chaque mois.',
];

const reconnais = [
  'Je ne comprends pas pourquoi je deviens une autre personne avant mes règles.',
  'Je mange bien, je fais du sport. Et pourtant, chaque mois, je m’effondre.',
  'J’ai l’impression de perdre qui je suis pendant sept à dix jours.',
  'Je suis fatiguée de tout tester sans comprendre ce qui se passe vraiment.',
  'Les conseils sont soit trop médicaux, soit trop vagues.',
];

const pourToi = [
  'Ta fin de cycle t’épuise, physiquement ou émotionnellement',
  'Tu fais déjà attention, mais rien ne change vraiment',
  'Tu veux comprendre, pas seulement tenir',
  'Tu cherches du concret, pas des généralités',
  'Tu es prête à adapter ton rythme à ton cycle',
];
const pasPourToi = [
  'Tu cherches un diagnostic ou un traitement',
  'Tu attends une solution miracle sans rien changer',
  'Tu ne ressens rien de particulier en fin de cycle',
  'Tu cherches un régime ou un programme de sport',
];

const contenu = [
  `${chapitres.length} chapitres, de la compréhension à la semaine type J17–J28`,
  `${recettes.length} recettes simples, rapides et rassasiantes`,
  `${outils.length} outils à imprimer : ${outils.map((o) => o.titre.replace(/ — .*/, '').replace(/^./, (c) => c.toLowerCase())).join(', ')}`,
  'Une version A4 et une version pour téléphone et liseuse',
  'Un PDF à télécharger et à garder',
];

const faq = [
  {
    q: 'C’est quoi exactement, ce guide ?',
    r: `Un guide PDF${pages ? ` de ${pages} pages` : ''} pour comprendre ta phase lutéale (J17 à J28) et t’organiser avec elle : des repères concrets pour manger, bouger et ralentir, une semaine type, ${recettes.length} recettes et des outils à imprimer.`,
  },
  {
    q: 'Je n’ai pas de diagnostic de SPM, c’est pour moi ?',
    r: 'Si tu remarques des changements physiques ou émotionnels en fin de cycle, oui. Pas besoin de diagnostic : le guide parle de tendances et de repères de mode de vie.',
  },
  {
    q: 'Comment je reçois le guide ?',
    r: 'Après le paiement, tu reçois un email avec ton lien de téléchargement. Le PDF est à toi : tu le gardes et tu le rouvres à chaque fin de cycle.',
  },
  {
    q: 'Est-ce que ça remplace un suivi médical ?',
    r: 'Non. Cycle Awakening propose un accompagnement de mode de vie. Douleur intense, saignements très abondants, symptômes nouveaux ou qui s’aggravent, humeur très basse : parles-en à ta sage-femme, ton ou ta gynécologue, ton médecin ou un·e psychologue.',
  },
  {
    q: 'Mes cycles ne font pas 28 jours. Ça marche quand même ?',
    r: 'Oui. J17–J28 est un repère pour un cycle moyen. Le guide t’apprend à repérer tes propres signaux pour caler les conseils sur ton cycle à toi.',
  },
  {
    q: 'Et si je veux aller plus loin ensuite ?',
    r: 'La newsletter t’envoie chaque semaine un repère et une recette. Un accompagnement personnalisé est en préparation : les inscrites seront prévenues en premier.',
  },
];
---

<PageLayout headerOverlay>
  <!-- HERO -->
  <section class="hero deep grain">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__in" style="--d: 0">Le guide de ta fin de cycle · J17–J28</p>
        <h1 class="hero__title">
          <span class="hero__in" style="--d: 1">Tu n’es pas</span>
          <span class="hero__in" style="--d: 2">instable.</span>
          <em class="accent hero__in" style="--d: 3">Tu es cyclique.</em>
        </h1>
        <p class="hero__lead hero__in" style="--d: 4">
          Fatigue, irritabilité, ventre gonflé, envie de disparaître quelques jours par mois : ta phase lutéale a une logique.
          Comprends-la, et organise-toi avec elle, pas contre elle.
        </p>
        <div class="hero__ctas hero__in" style="--d: 5">
          <Cta location="hero" variant="on-deep" />
          <a class="hero__link" href="#guide">Découvrir le guide <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero__visual hero__in" style="--d: 2">
        <CycleWheel />
      </div>
    </div>
  </section>

  <Marquee phrases={phrases} />

  <!-- FAITS (vrais, issus du livre) -->
  <section class="faits" aria-label="Le guide en chiffres">
    <div class="container faits__grid">
      {faits.map((f, i) => (
        <div class="fait" data-reveal style={`--d: ${i}`}>
          <span class="fait__chiffre">{f.chiffre}</span>
          <span class="fait__libelle">{f.libelle}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLÈME -->
  <section class="section probleme" id="probleme">
    <div class="container probleme__grid">
      <div class="probleme__titre">
        <p class="eyebrow">Le problème</p>
        <h2>Tu te <em class="accent">reconnais</em> ?</h2>
        <p class="probleme__chute" data-reveal>
          Ce n’est pas dans ta tête. Ce n’est pas un manque de volonté. C’est une phase de ton cycle, avec ses propres règles.
        </p>
      </div>
      <ol class="probleme__liste">
        {reconnais.map((r, i) => (
          <li class="citation" data-reveal>
            <span class="citation__num">0{i + 1}</span>
            <p>« {r} »</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TON CYCLE -->
  <section class="section deep grain cycle" id="cycle">
    <div class="container">
      <p class="eyebrow">Comprendre d’abord</p>
      <h2 class="cycle__titre">Ton cycle en <em class="accent">quatre temps</em></h2>
      <CyclePhases />
    </div>
  </section>

  <!-- HISTOIRE -->
  <section class="section histoire">
    <div class="container histoire__grid">
      <figure class="histoire__photo" data-reveal>
        <img src="/images/site/mer.webp" alt="" width="1400" height="933" loading="lazy" decoding="async" />
      </figure>
      <div class="histoire__texte">
        <p class="eyebrow">Mon histoire</p>
        <h2>Le problème n’est pas ta <em class="accent">discipline.</em></h2>
        <p class="histoire__lead" data-reveal>
          Pendant des années, j’ai vécu exactement ça : disparaître quelques jours par mois sans comprendre pourquoi.
        </p>
        <p data-reveal>
          J’ai cherché, testé, croisé nutrition, mouvement et compréhension du cycle. Ce guide, c’est celui que j’aurais voulu
          trouver : simple, concret, sans culpabilité.
        </p>
        <p class="histoire__signature" data-reveal>Emeline<span>, fondatrice de Cycle Awakening</span></p>
      </div>
    </div>
  </section>

  <!-- LE GUIDE -->
  <section class="section sage guide" id="guide">
    <div class="container guide__grid">
      <div class="livre" data-reveal>
        <div class="livre__objet">
          <div class="livre__couverture">
            <img src="/brand/logo-clair.svg" alt="" class="livre__logo" />
            <p class="livre__titre">Le Guide</p>
            <p class="livre__sous">Comprendre et traverser ta phase lutéale,<br />J17–J28</p>
            <span class="livre__filet"></span>
          </div>
          <div class="livre__tranche" aria-hidden="true"></div>
        </div>
      </div>
      <div>
        <p class="eyebrow">Le guide</p>
        <h2>Tout ce qu’il faut pour ta <em class="accent">fin de cycle</em></h2>
        <ol class="chapitres">
          {chapitres.map((c) => (
            <li class="chapitre" data-reveal>
              <span class="chapitre__num">{String(c.ordre).padStart(2, '0')}</span>
              <span>
                <span class="chapitre__titre">{c.titre}</span>
                <span class="chapitre__accroche">{c.accroche}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="container recettes">
      <div class="recettes__entete">
        <h3>Et une cuisine de fin de cycle, <em class="signature">vraiment simple</em></h3>
        <p>{recettes.length} recettes rapides et rassasiantes, du banana bread au lait d’or.</p>
      </div>
      <ul class="recettes__grille">
        {vitrine.map((r, i) => (
          <li class="recette" data-reveal style={`--d: ${i}`}>
            <img src={photosRecettes[r.photo]} alt={r.titre} loading="lazy" decoding="async" />
            <span class="recette__legende">
              <span class="recette__nom">{r.nom}</span>
              <span class="recette__temps">{r.temps}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- POUR QUI -->
  <section class="section pourqui">
    <div class="container">
      <p class="eyebrow">Pour qui</p>
      <h2>Ce guide est fait <em class="accent">pour toi</em> si…</h2>
      <div class="pourqui__grid">
        <ul class="liste liste--oui" data-reveal>
          <li class="liste__titre">Oui, c’est toi</li>
          {pourToi.map((l) => <li>{l}</li>)}
        </ul>
        <ul class="liste liste--non" data-reveal>
          <li class="liste__titre">Pas pour toi si</li>
          {pasPourToi.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- OFFRE -->
  <section class="section deep grain offre" id="offre">
    <div class="container offre__grid">
      <div>
        <p class="eyebrow">L’offre</p>
        <h2>Cycle Awakening, <em class="accent">le guide</em></h2>
        <p class="offre__intro">Comprendre, nourrir, bouger, ralentir : la méthode pour traverser ta phase lutéale sans te perdre.</p>
      </div>
      <div class="offre__carte" data-reveal>
        <p class="offre__prix">{prix}</p>
        <p class="offre__modalite">Paiement unique</p>
        <ul class="offre__liste">
          {contenu.map((c) => <li>{c}</li>)}
        </ul>
        <Cta location="offre" variant="primary" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container faq__grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2>Tes <em class="accent">questions</em></h2>
      </div>
      <div class="faq__liste">
        {faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="section sage newsletter" id="newsletter">
    <div class="container newsletter__grid">
      <div>
        <p class="eyebrow">La newsletter</p>
        <h2>Chaque semaine, un repère <em class="accent">pour ta phase</em></h2>
        <ul class="newsletter__plus">
          <li>Un repère simple selon le moment de ton cycle</li>
          <li>Une nouvelle recette de saison</li>
          <li>Les nouveautés de Cycle Awakening en avant-première</li>
        </ul>
      </div>
      <div class="newsletter__form" data-reveal>
        <NewsletterForm source="home" />
        <p class="newsletter__note">Tu recevras un email pour confirmer ton inscription. Pas de spam, jamais.</p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; min-height: 100svh; display: flex; align-items: center; padding-block: calc(var(--space-16) + 4rem) var(--space-16); }
  .hero__glow {
    position: absolute; inset: -20% -10% auto auto; width: 70vmax; height: 70vmax; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgb(159 192 176 / 0.16) 0%, rgb(159 192 176 / 0) 60%);
  }
  .hero__grid { position: relative; display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 60rem) { .hero__grid { grid-template-columns: 1.15fr 1fr; } }
  .hero__title { font-size: clamp(3.1rem, 1.6rem + 6.4vw, 7.4rem); line-height: 0.95; letter-spacing: -0.02em; margin-bottom: var(--space-8); }
  .hero__title span, .hero__title em { display: block; }
  .hero__lead { font-size: var(--font-size-lg); color: var(--semantic-text-on-deep-muted); max-width: 34rem; margin-bottom: var(--space-8); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: center; }
  .hero__link { color: var(--semantic-text-on-deep); font-size: var(--font-size-sm); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-block: var(--space-2); }
  .hero :global(.cta-note) { color: var(--semantic-text-on-deep-muted); }
  .hero__in { opacity: 0; transform: translateY(24px); animation: entree 1s var(--motion-ease) forwards; animation-delay: calc(0.15s + var(--d) * 0.12s); }
  @keyframes entree { to { opacity: 1; transform: none; } }

  /* ---------- Faits ---------- */
  .faits { background: var(--semantic-bg); padding-block: var(--space-12); border-bottom: 1px solid var(--semantic-line); }
  .faits__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-6); }
  @media (min-width: 52rem) { .faits__grid { grid-template-columns: repeat(4, 1fr); } }
  .fait { display: grid; gap: var(--space-2); }
  .fait__chiffre { font-family: 'Limelight', var(--font-family-display); font-size: clamp(2.6rem, 2rem + 2.5vw, 4rem); line-height: 1; color: var(--semantic-text); }
  .fait__libelle { font-size: var(--font-size-sm); color: var(--semantic-text-muted); max-width: 14rem; }

  /* ---------- Problème ---------- */
  .probleme__grid { display: grid; gap: var(--space-12); }
  @media (min-width: 60rem) {
    .probleme__grid { grid-template-columns: 1fr 1.2fr; align-items: start; }
    .probleme__titre { position: sticky; top: 7rem; }
  }
  .probleme h2 { font-size: clamp(2.6rem, 1.8rem + 3.6vw, 5rem); }
  .probleme__chute { font-family: var(--font-family-display); font-size: var(--font-size-xl); line-height: 1.3; }
  .probleme__liste { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .citation {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-6); align-items: baseline;
    padding: var(--space-8); border-radius: var(--radius-md); background: var(--semantic-bg-alt);
    transition: transform var(--motion-duration-base) var(--motion-ease), background-color var(--motion-duration-base) var(--motion-ease);
  }
  .citation:hover { transform: translateX(6px); background: var(--semantic-bg-muted); }
  .citation__num { font-family: 'Limelight', var(--font-family-display); color: var(--semantic-accent-text); font-size: var(--font-size-lg); }
  .citation p { margin: 0; font-family: var(--font-family-display); font-style: italic; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.3; }

  /* ---------- Cycle ---------- */
  .cycle__titre { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.6rem); margin-bottom: var(--space-12); }

  /* ---------- Histoire ---------- */
  .histoire__grid { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 60rem) { .histoire__grid { grid-template-columns: 1fr 1fr; } }
  .histoire__photo { margin: 0; border-radius: 999px 999px var(--radius-md) var(--radius-md); overflow: hidden; aspect-ratio: 4 / 5; box-shadow: var(--shadow-lift); }
  .histoire__photo img { width: 100%; height: 100%; object-fit: cover; }
  .histoire h2 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.4rem); }
  .histoire__lead { font-family: var(--font-family-display); font-size: var(--font-size-xl); line-height: 1.3; }
  .histoire__signature { font-family: var(--font-family-display); font-style: italic; font-size: var(--font-size-xl); color: var(--semantic-accent-text); margin-top: var(--space-8); }
  .histoire__signature span { font-family: var(--font-family-body); font-style: normal; font-size: var(--font-size-sm); color: var(--semantic-text-muted); }

  /* ---------- Guide ---------- */
  .guide__grid { display: grid; gap: var(--space-16); align-items: center; }
  @media (min-width: 60rem) { .guide__grid { grid-template-columns: 0.9fr 1.1fr; } }
  .livre { perspective: 1600px; display: grid; place-items: center; padding-block: var(--space-8); }
  .livre__objet { position: relative; width: min(78vw, 22rem); aspect-ratio: 210 / 297; transform: rotateY(-22deg) rotateX(4deg); transform-style: preserve-3d; transition: transform 0.8s var(--motion-ease); }
  .livre:hover .livre__objet { transform: rotateY(-6deg) rotateX(0deg) translateY(-6px); }
  .livre__couverture {
    position: absolute; inset: 0; border-radius: 3px 10px 10px 3px; padding: 14% 12%;
    background: linear-gradient(165deg, var(--semantic-bg-deep-alt), var(--semantic-bg-deep) 55%, var(--semantic-bg-deep-intense));
    color: var(--semantic-text-on-deep); display: flex; flex-direction: column; justify-content: space-between;
    box-shadow: 30px 40px 60px -20px rgb(26 48 40 / 0.55), inset 6px 0 10px -6px rgb(0 0 0 / 0.4);
  }
  .livre__logo { width: 72%; }
  .livre__titre { font-family: var(--font-family-display); font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem); margin: auto 0 var(--space-2); }
  .livre__sous { font-family: var(--font-family-display); font-style: italic; font-size: var(--font-size-sm); color: var(--semantic-text-on-deep-muted); margin: 0; }
  .livre__filet { display: block; width: 3rem; height: 2px; background: var(--semantic-accent); margin-top: var(--space-6); }
  .livre__tranche { position: absolute; top: 2px; bottom: 2px; right: -14px; width: 14px; background: repeating-linear-gradient(180deg, var(--semantic-bg) 0 2px, var(--semantic-bg-muted) 2px 3px); transform: rotateY(90deg); transform-origin: left; border-radius: 0 3px 3px 0; }
  .guide h2 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.8rem); }
  .chapitres { list-style: none; margin: var(--space-8) 0 0; padding: 0; }
  .chapitre { display: grid; grid-template-columns: 3.2rem 1fr; gap: var(--space-4); padding-block: var(--space-4); border-top: 1px solid var(--semantic-line); transition: padding var(--motion-duration-base) var(--motion-ease); }
  .chapitre:hover { padding-left: var(--space-2); }
  .chapitre__num { font-family: 'Limelight', var(--font-family-display); font-size: var(--font-size-lg); color: var(--semantic-accent-text); }
  .chapitre__titre { display: block; font-family: var(--font-family-display); font-size: var(--font-size-xl); line-height: 1.2; }
  .chapitre__accroche { display: block; font-size: var(--font-size-sm); color: var(--semantic-text-muted); margin-top: var(--space-1); }

  .recettes { margin-top: var(--space-section); }
  .recettes__entete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-4); margin-bottom: var(--space-8); }
  .recettes__entete h3 { font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.8rem); margin: 0; max-width: 32rem; }
  .recettes__entete p { margin: 0; color: var(--semantic-text-muted); }
  .recettes__grille { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  @media (min-width: 60rem) { .recettes__grille { grid-template-columns: repeat(4, 1fr); } .recette:nth-child(even) { margin-top: var(--space-12); } }
  .recette { position: relative; border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 3 / 4; color: var(--semantic-text-on-deep); }
  .recette img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--motion-ease); }
  .recette:hover img { transform: scale(1.06); }
  .recette::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(26 48 40 / 0) 45%, rgb(26 48 40 / 0.85)); }
  .recette__legende { position: absolute; left: var(--space-4); right: var(--space-4); bottom: var(--space-4); z-index: 1; display: grid; gap: var(--space-1); }
  .recette__nom { font-family: var(--font-family-display); font-size: var(--font-size-xl); line-height: 1.1; }
  .recette__temps { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--semantic-text-on-deep); }

  /* ---------- Pour qui ---------- */
  .pourqui h2 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.8rem); }
  .pourqui__grid { display: grid; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 52rem) { .pourqui__grid { grid-template-columns: 1.2fr 1fr; } }
  .liste { list-style: none; margin: 0; padding: var(--space-8); border-radius: var(--radius-md); display: grid; gap: var(--space-3); }
  .liste li:not(.liste__titre) { position: relative; padding-left: var(--space-8); }
