---
// Page de succès Stripe (URL de redirection après paiement). Non indexée.
// Aucune donnée personnelle n'est affichée ni lue dans l'URL.
import PageLayout from '../layouts/PageLayout.astro';
import { legal } from '../config/legal';
import PageHero from '../components/PageHero.astro';
---

<PageLayout title="Merci" description="Ton guide Cycle Awakening est en route." noindex headerCta={false}>
  <PageHero eyebrow="Commande confirmée" title={'Merci. <em class="accent">Ton guide est en route.</em>'} lead="Tu vas recevoir dans quelques minutes un email avec ton lien de téléchargement personnel." />
  <section class="section">
    <div class="container merci">
      <ol class="steps">
        <li class="glass">
          <h2>Ouvre l’email « Ton guide Cycle Awakening »</h2>
          <p>Il est envoyé à l’adresse utilisée pour le paiement. Le lien est valable 7 jours et permet 5 téléchargements.</p>
        </li>
        <li class="glass">
          <h2>Rien reçu après 15 minutes ?</h2>
          <p>Regarde dans les spams ou l’onglet « Promotions ». Si tu le trouves là, déplace-le dans ta boîte principale : les prochains arriveront au bon endroit.</p>
        </li>
        <li class="glass">
          <h2>Toujours rien ?</h2>
          <p>
            Écris-nous à <a href={`mailto:${legal.editor.email}?subject=Je%20n%E2%80%99ai%20pas%20re%C3%A7u%20mon%20guide`}>{legal.editor.email}</a>{' '}
            depuis l’adresse de ton achat : on te renvoie ton lien.
          </p>
        </li>
      </ol>

      <p class="note">
        Prends ton temps pour le lire. Commence par la partie qui te parle le plus : il n’y a pas d’ordre imposé.
      </p>
      <p><a href="/">Revenir à l’accueil</a></p>
    </div>
  </section>
</PageLayout>

<script>
  // Événement d'achat pour l'analytics (branché à l'étape 3, sans cookie). Aucune donnée personnelle.
  window.dispatchEvent(new CustomEvent('ca:track', { detail: { event: 'purchase', offer: 'guide' } }));
</script>

<style>
  .merci { max-width: calc(var(--size-content) + 2 * var(--space-gutter)); }
  .lead { font-size: var(--font-size-lg); }
  .steps { list-style: none; padding: 0; margin: var(--space-12) 0; display: grid; gap: var(--space-6); counter-reset: step; }
  .steps li {
    counter-increment: step;
    position: relative;
    padding: var(--space-6) var(--space-6) var(--space-4) calc(var(--space-6) + 2.5rem);
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: var(--space-6);
    top: var(--space-6);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    line-height: 1;
    color: var(--semantic-text-muted);
  }
  .steps h2 { font-size: var(--font-size-lg); margin-bottom: var(--space-2); }
  .note { color: var(--semantic-text-muted); }
</style>
