---
// Article (français). Gabarit : src/views/BlogArticle.astro (partagé avec /en/blog/[slug]).
import BlogArticle from '../../views/BlogArticle.astro';
import { articles, slugOf } from '../../data/blog';

export async function getStaticPaths() {
  const liste = await articles('fr');
  return liste.map((a) => ({ params: { slug: slugOf(a) }, props: { article: a, tous: liste } }));
}
const { article, tous } = Astro.props;
---

<BlogArticle article={article} tous={tous} />
