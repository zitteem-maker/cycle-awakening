---
// Page 404 (Cloudflare Pages sert automatiquement 404.html pour toute URL inconnue).
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<PageLayout title="Page introuvable" description="Cette page n’existe pas ou plus." noindex>
  <PageHero
    size="page"
    eyebrow="Erreur 404"
    title={'Cette page s’est <em class="accent">perdue en chemin.</em>'}
    lead="Le lien est peut-être ancien, ou l’adresse contient une faute de frappe. Rien de grave."
  >
    <ul class="nf__links">
      <li><a class="glass-deep nf__lien" href="/">Revenir à l’accueil</a></li>
      <li><a class="glass-deep nf__lien" href="/#newsletter">Recevoir les prochains contenus</a></li>
    </ul>
  </PageHero>
</PageLayout>

<style>
  .nf__links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .nf__lien { display: inline-flex; align-items: center; min-height: var(--size-tap-target); padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); text-decoration: none; }
</style>
