---
// Inscription newsletter → /api/newsletter (Cloudflare Pages Function, functions/api/newsletter.js),
// qui transmet à Brevo en double opt-in. Aucune clé côté navigateur.
// Sans JavaScript, le formulaire s'envoie normalement et la fonction redirige vers /newsletter-confirmation.
interface Props {
  /** Emplacement du formulaire (tag de segmentation et tracking). */
  source: string;
  variant?: 'light' | 'deep';
}
import { langOf, path, t } from '../i18n';
const { source, variant = 'light' } = Astro.props;
const id = `nl-${source}`;
const lang = langOf(Astro.url);
const tx = t(lang).nl;
const messages = JSON.stringify({ verifie: tx.verifie, coche: tx.coche, envoi: tx.envoi, presque: tx.presque, oups: tx.oups });
---

<form class:list={['nl', `nl--${variant}`]} method="post" action="/api/newsletter" data-newsletter data-messages={messages} novalidate>
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="lang" value={lang} />
  <!-- Piège à robots : champ invisible, doit rester vide. -->
  <div class="nl__trap" aria-hidden="true">
    <label for={`${id}-site`}>{tx.trap}</label>
    <input id={`${id}-site`} name="site" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="nl__row">
    <label class="visually-hidden" for={`${id}-email`}>{tx.emailLabel}</label>
    <input id={`${id}-email`} class="nl__email" name="email" type="email" required autocomplete="email" placeholder={tx.placeholder} />
    <button class="nl__btn" type="submit">{tx.bouton}</button>
  </div>
  <label class="nl__consent">
    <input type="checkbox" name="consent" value="oui" required />
    <span>{tx.consentement} <a href={path('confidentialite', lang)}>{tx.politique}</a>.</span>
  </label>
  <p class="nl__status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-newsletter]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const m = JSON.parse(form.dataset.messages || '{}') as Record<string, string>;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = m.verifie;
        return;
      }
      if (!data.get('consent')) {
        status.textContent = m.coche;
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button')!;
      btn.disabled = true;
      status.textContent = m.envoi;
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.message || 'erreur');
        form.classList.add('is-done');
        status.textContent = m.presque;
        window.dispatchEvent(new CustomEvent('ca:event', { detail: { name: 'newsletter_signup', source: data.get('source') } }));
      } catch (err) {
        status.textContent = (err as Error).message !== 'erreur'
          ? (err as Error).message
          : m.oups;
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .nl { display: grid; gap: var(--space-4); max-width: 34rem; }
  .nl__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .nl__row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .nl__email {
    flex: 1 1 14rem; min-height: var(--size-tap-target); padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill); border: 1px solid var(--semantic-text); background: var(--semantic-bg);
    color: var(--semantic-text); font: inherit;
  }
  .nl__btn {
    min-height: var(--size-tap-target); padding: var(--space-3) var(--space-8); border-radius: var(--radius-pill); border: 0; cursor: pointer;
    background: var(--semantic-cta-bg); color: var(--semantic-cta-text);
    font: inherit; font-size: var(--font-size-xs); font-weight: var(--font-weight-medium); letter-spacing: 0.1em; text-transform: uppercase;
    transition: background-color var(--motion-duration-fast) var(--motion-ease), transform var(--motion-duration-fast) var(--motion-ease);
  }
  .nl__btn:hover { background: var(--semantic-cta-bg-hover); transform: translateY(-2px); }
  .nl__btn:disabled { opacity: 0.6; cursor: wait; }
  .nl__consent { display: flex; gap: var(--space-3); align-items: flex-start; font-size: var(--font-size-xs); color: var(--semantic-text-muted); line-height: 1.5; }
  .nl__consent input { width: 1.15rem; height: 1.15rem; margin-top: 0.1rem; flex: none; accent-color: var(--semantic-cta-bg); }
  .nl__status { font-size: var(--font-size-sm); min-height: 1.5em; margin: 0; }
  .nl.is-done .nl__row, .nl.is-done .nl__consent { display: none; }
  .nl.is-done .nl__status { font-family: var(--font-family-display); font-size: var(--font-size-lg); }

  .nl--deep .nl__email { background: transparent; border-color: rgb(247 244 239 / 0.5); color: var(--semantic-text-on-deep); }
  .nl--deep .nl__email::placeholder { color: var(--semantic-text-on-deep-muted); }
  .nl--deep .nl__btn { background: var(--semantic-cta-on-deep-bg); color: var(--semantic-cta-on-deep-text); }
  .nl--deep .nl__btn:hover { background: var(--semantic-bg-alt); }
  .nl--deep .nl__consent { color: var(--semantic-text-on-deep-muted); }
  .nl--deep .nl__consent input { accent-color: var(--semantic-text-on-deep); }
</style>
