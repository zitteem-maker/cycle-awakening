---
import Logo from './Logo.astro';
import { legal, salesReady } from '../config/legal';
import { langOf, path, t } from '../i18n';
const year = new Date().getFullYear();
const lang = langOf(Astro.url);
const f = t(lang).footer;
---

<footer class="site-footer deep grain">
  <div class="container site-footer__inner">
    <div>
      <a href={path('accueil', lang)} class="site-footer__logo" aria-label={t(lang).accueilAria}><Logo /></a>
      <p class="site-footer__tagline signature">{f.signature}</p>
    </div>
    <nav aria-label={f.aria}>
      <ul class="site-footer__links">
        <li><a href={path('apropos', lang)}>{f.apropos}</a></li>
        <li><a href={path('blog', lang)}>{f.blog}</a></li>
        <li><a href={path('recommandations', lang)}>{f.recommandations}</a></li>
        <li><a href={path('mentions', lang)}>{f.mentions}</a></li>
        {salesReady && <li><a href={path('cgv', lang)}>{f.cgv}</a></li>}
        <li><a href={path('confidentialite', lang)}>{f.confidentialite}</a></li>
        <li><a href={path('cookies', lang)}>{f.cookies}</a></li>
        <li><a href={`mailto:${legal.editor.email}`}>{legal.editor.email}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container">
    <p class="site-footer__disclaimer">{f.disclaimer}</p>
    <p class="site-footer__copy">© {year} Cycle Awakening</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-16) var(--space-8); font-size: var(--font-size-sm); }
  .site-footer__inner { display: grid; gap: var(--space-8); margin-bottom: var(--space-12); }
  @media (min-width: 48rem) { .site-footer__inner { grid-template-columns: 1fr auto; align-items: start; } }
  .site-footer__logo { display: inline-block; color: var(--semantic-text-on-deep); }
  .site-footer__logo :global(svg) { width: 15rem; height: auto; }
  .site-footer__tagline { font-size: var(--font-size-lg); color: var(--semantic-text-on-deep-muted); margin-top: var(--space-4); }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer__links a { display: inline-block; padding-block: var(--space-1); }
  .site-footer__disclaimer { color: var(--semantic-text-on-deep-muted); max-width: 60ch; }
  .site-footer__copy { color: var(--semantic-text-on-deep-muted); font-size: var(--font-size-xs); margin-top: var(--space-6); }
</style>
