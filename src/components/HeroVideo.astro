---
// Fond de hero : vidéo d'ambiance accessible, ou illustration « horizon » si aucune vidéo n'est fournie.
// Voir le skill hero-video (.claude/skills/hero-video) pour choisir, licencier et compresser la vidéo.
// - poster affiché immédiatement (pas de flash), vidéo chargée seulement si le mouvement est autorisé
//   et que l'économie de données n'est pas activée ;
// - bouton pause/lecture (WCAG 2.2.2) ;
// - la vidéo est décorative : aria-hidden, sans son.
import Horizon from './art/Horizon.astro';

interface Source {
  src: string;
  type: 'video/mp4' | 'video/webm';
  /** Media query optionnelle, ex. « (max-width: 700px) » pour la version mobile. */
  media?: string;
}
interface Props {
  sources?: Source[];
  poster?: string;
}
const { sources = [], poster } = Astro.props;
const hasVideo = sources.length > 0;
---

<div class="hero-media" data-hero-media>
  {poster ? <img class="hero-media__poster" src={poster} alt="" fetchpriority="high" decoding="async" /> : <Horizon />}
  {hasVideo && (
    <>
      <video class="hero-media__video" muted loop playsinline preload="none" aria-hidden="true" data-hero-video hidden>
        {sources.map((s) => <source data-src={s.src} type={s.type} media={s.media} />)}
      </video>
      <button class="hero-media__toggle" type="button" data-hero-toggle hidden aria-label="Mettre la vidéo en pause">
        <span aria-hidden="true" data-icon>❙❙</span>
      </button>
    </>
  )}
  <div class="hero-media__veil" aria-hidden="true"></div>
</div>

{hasVideo && (
  <script>
    const root = document.querySelector<HTMLElement>('[data-hero-media]');
    const video = root?.querySelector<HTMLVideoElement>('[data-hero-video]');
    const toggle = root?.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    if (video && toggle && !reduce && !saveData) {
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => (s.src = s.dataset.src!));
      video.load();
      video.addEventListener('playing', () => root!.classList.add('is-playing'), { once: true });
      video.hidden = false;
      toggle.hidden = false;
      video.play().catch(() => {
        video.hidden = true;
        toggle.hidden = true;
      });
      toggle.addEventListener('click', () => {
        const icon = toggle.querySelector('[data-icon]')!;
        if (video.paused) {
          video.play();
          toggle.setAttribute('aria-label', 'Mettre la vidéo en pause');
          icon.textContent = '❙❙';
        } else {
          video.pause();
          toggle.setAttribute('aria-label', 'Lire la vidéo');
          icon.textContent = '▶';
        }
      });
    }
  </script>
)}

<style>
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--semantic-bg-deep);
  }
  .hero-media__poster,
  .hero-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-media__video {
    opacity: 0;
    transition: opacity var(--motion-duration-hero) var(--motion-ease);
  }
  .is-playing .hero-media__video { opacity: 1; }
  .hero-media__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(46 58 68 / 0.62) 0%, rgb(46 58 68 / 0.25) 70%, rgb(46 58 68 / 0.1) 100%);
  }
  .hero-media__toggle {
    position: absolute;
    right: var(--space-gutter);
    bottom: var(--space-6);
    z-index: 2;
    width: var(--size-tap-target);
    height: var(--size-tap-target);
    border-radius: 50%;
    border: 1px solid var(--semantic-text-on-deep-muted);
    background: rgb(46 58 68 / 0.5);
    color: var(--semantic-text-on-deep);
    font-size: var(--font-size-xs);
    cursor: pointer;
  }
  .hero-media__toggle:focus-visible { outline-color: var(--semantic-focus-on-deep); }
</style>
