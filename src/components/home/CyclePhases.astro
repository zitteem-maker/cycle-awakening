---
// « Ton cycle en quatre temps » : onglets accessibles (clavier : flèches gauche/droite).
// Textes repris du chapitre 1 du guide, formulés en tendances, sans diagnostic.
const phases = [
  {
    id: 'regles', nom: 'Règles', jours: 'J1 – J5', part: 5,
    corps: 'Les hormones sont à leur niveau le plus bas. Le corps élimine la muqueuse de l’utérus.',
    ressenti: 'Beaucoup ressentent : fatigue, besoin de chaleur, envie de rester au calme.',
  },
  {
    id: 'folliculaire', nom: 'Folliculaire', jours: 'J6 – J13', part: 8,
    corps: 'Les œstrogènes remontent, un follicule se prépare dans l’ovaire.',
    ressenti: 'Beaucoup ressentent : l’énergie qui revient, l’envie de faire, de voir du monde.',
  },
  {
    id: 'ovulation', nom: 'Ovulation', jours: '≈ J14', part: 1,
    corps: 'Pic hormonal : l’ovule est libéré. Un moment court, souvent vers le milieu du cycle.',
    ressenti: 'Beaucoup ressentent : de l’élan, de la confiance.',
  },
  {
    id: 'luteale', nom: 'Lutéale', jours: 'J15 – J28', part: 14,
    corps: 'La progestérone domine, puis toutes les hormones redescendent avant les règles.',
    ressenti: 'Beaucoup ressentent : ralentissement, sensibilité, ballonnements, envies, sommeil plus léger. C’est là que le guide t’accompagne, de J17 à J28.',
  },
];
---

<div class="phases" data-phases>
  <div class="phases__bar" aria-hidden="true">
    {Array.from({ length: 28 }, (_, i) => {
      const j = i + 1;
      const p = j <= 5 ? 'regles' : j <= 13 ? 'folliculaire' : j === 14 ? 'ovulation' : 'luteale';
      return <span class:list={['phases__jour', `phases__jour--${p}`, { 'phases__jour--zone': j >= 17 }]} data-for={p}>{j}</span>;
    })}
  </div>

  <div class="phases__tabs" role="tablist" aria-label="Les quatre temps du cycle">
    {phases.map((p, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${p.id}`}
        aria-controls={`panel-${p.id}`}
        aria-selected={p.id === 'luteale' ? 'true' : 'false'}
        tabindex={p.id === 'luteale' ? 0 : -1}
        class="phases__tab"
        data-tab={p.id}
      >
        <span class="phases__num">0{i + 1}</span>
        <span>{p.nom}</span>
        <span class="phases__jours">{p.jours}</span>
      </button>
    ))}
  </div>

  {phases.map((p) => (
    <div class="phases__panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={p.id !== 'luteale'} tabindex="0">
      <p class="phases__corps">{p.corps}</p>
      <p class="phases__ressenti">{p.ressenti}</p>
    </div>
  ))}
  <p class="phases__note">Repères pour un cycle moyen de 28 jours. Le tien peut être plus court ou plus long : c’est normal.</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-phases]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      }
      root.dataset.active = tab.dataset.tab;
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length], true); }
      });
    });
    root.dataset.active = 'luteale';

    // Pilotage au défilement (section épinglée, voir src/scripts/motion.ts) : le jour courant
    // s'allume dans la barre et l'onglet de sa phase s'ouvre.
    const jours = [...root.querySelectorAll<HTMLElement>('.phases__jour')];
    let derniere = '';
    window.addEventListener('ca:cycle-day', (e) => {
      const j = (e as CustomEvent<number>).detail;
      root.classList.add('is-scrubbing');
      jours.forEach((el, i) => {
        el.classList.toggle('is-passe', i + 1 <= j);
        el.classList.toggle('is-jour', i + 1 === j);
      });
      const id = j <= 5 ? 'regles' : j <= 13 ? 'folliculaire' : j === 14 ? 'ovulation' : 'luteale';
      if (id !== derniere) {
        derniere = id;
        select(tabs.find((t) => t.dataset.tab === id)!);
      }
      root.style.setProperty('--progression', String(j / 28));
    });
  }
</script>

<style>
  .phases__bar { display: grid; grid-template-columns: repeat(28, minmax(0, 1fr)); gap: 2px; margin-bottom: var(--space-8); }
  .phases__jour {
    aspect-ratio: 1 / 2.4; border-radius: var(--radius-pill); display: grid; place-items: end center; padding-bottom: 4px;
    font-size: 0; color: transparent; min-width: 0; background: rgb(247 244 239 / 0.12);
    transition: background-color var(--motion-duration-base) var(--motion-ease), transform var(--motion-duration-base) var(--motion-ease);
  }
  .phases__jour--zone { box-shadow: inset 0 -3px 0 var(--semantic-accent); }
  [data-active='regles'] .phases__jour--regles,
  [data-active='folliculaire'] .phases__jour--folliculaire,
  [data-active='ovulation'] .phases__jour--ovulation,
  [data-active='luteale'] .phases__jour--luteale { background: var(--semantic-text-on-deep); color: var(--semantic-bg-deep); transform: scaleY(1.08); }
  @media (min-width: 48rem) { .phases__bar { gap: 4px; } .phases__jour { font-size: 0.7rem; } }

  .phases__tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); margin-bottom: var(--space-8); }
  @media (min-width: 48rem) { .phases__tabs { grid-template-columns: repeat(4, 1fr); } }
  .phases__tab {
    display: grid; gap: var(--space-1); text-align: left; min-height: var(--size-tap-target);
    padding: var(--space-4); border-radius: var(--radius-md); cursor: pointer;
    background: transparent; color: var(--semantic-text-on-deep); border: 1px solid rgb(247 244 239 / 0.2);
    font: inherit; font-family: var(--font-family-display); font-size: var(--font-size-lg);
    transition: background-color var(--motion-duration-fast) var(--motion-ease), border-color var(--motion-duration-fast) var(--motion-ease);
  }
  .phases__tab:hover { border-color: var(--semantic-text-on-deep); }
  .phases__tab[aria-selected='true'] { background: var(--semantic-text-on-deep); color: var(--semantic-bg-deep); border-color: transparent; }
  .phases__num { font-family: 'Limelight', var(--font-family-display); font-size: var(--font-size-sm); opacity: 0.7; }
  .phases__jours { font-family: var(--font-family-body); font-size: var(--font-size-xs); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.75; }
  .phases__panel { max-width: 46rem; animation: apparait var(--motion-duration-base) var(--motion-ease); }
  .phases__corps { font-family: var(--font-family-display); font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem); line-height: 1.25; margin-bottom: var(--space-4); }
  .phases__ressenti { color: var(--semantic-text-on-deep-muted); font-size: var(--font-size-lg); }
  .phases__note { font-size: var(--font-size-xs); color: var(--semantic-text-on-deep-muted); margin-top: var(--space-8); }
  /* Mode défilement : les jours passés s'allument, le jour courant grandit. */
  .is-scrubbing .phases__jour { background: rgb(247 244 239 / 0.1); color: transparent; transform: none; }
  .is-scrubbing .phases__jour.is-passe { background: rgb(247 244 239 / 0.55); }
  .is-scrubbing .phases__jour.is-passe.phases__jour--zone { background: var(--semantic-accent); }
  .is-scrubbing .phases__jour.is-jour { background: var(--semantic-text-on-deep); color: var(--semantic-bg-deep); transform: scaleY(1.25); }
  @keyframes apparait { from { opacity: 0; transform: translateY(8px); } }
</style>
