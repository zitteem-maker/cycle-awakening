---
// Roue du cycle (28 jours), visuel signature du hero, dessinée comme une VUE ÉCLATÉE DE MONTRE :
// quatre plateaux superposés en 3D, repérés 01 à 04 et légendés.
//   01 les 28 jours (graduations) · 02 les quatre phases en verre liquide
//   03 ta zone J17–J28 (verre fuchsia) · 04 le repère du jour + le compteur
// src/scripts/motion.ts : les plateaux se posent en vue éclatée, puis s'assemblent au défilement.
// Sans JavaScript ou en mouvement réduit : la roue s'affiche assemblée, à plat. Décorative (aria-hidden).
import { langOf } from '../../i18n';
const lang = langOf(Astro.url);
const en = lang === 'en';
/** Préfixe des jours : J17 en français, D17 (Day 17) en anglais. */
const J = en ? 'D' : 'J';
const C = 200;
const R = 158;
const EP = 13;
const jours = 28;
const angle = (j: number) => ((j - 1) / jours) * 2 * Math.PI - Math.PI / 2;
const pt = (j: number, r: number) => [C + r * Math.cos(angle(j)), C + r * Math.sin(angle(j))];
const f = (n: number) => n.toFixed(2);
function secteur(debut: number, fin: number, ecart = 0.14, r = R, ep = EP) {
  const a = debut + ecart;
  const b = fin + 1 - ecart;
  const grand = b - a > jours / 2 ? 1 : 0;
  const [x1, y1] = pt(a, r + ep);
  const [x2, y2] = pt(b, r + ep);
  const [x3, y3] = pt(b, r - ep);
  const [x4, y4] = pt(a, r - ep);
  return `M${f(x1)} ${f(y1)} A${r + ep} ${r + ep} 0 ${grand} 1 ${f(x2)} ${f(y2)} L${f(x3)} ${f(y3)} A${r - ep} ${r - ep} 0 ${grand} 0 ${f(x4)} ${f(y4)} Z`;
}
// Repères moyens pour un cycle de 28 jours (le site rappelle que chaque cycle est différent).
const phases = [
  { id: 'regles', nom: en ? 'Period' : 'Règles', debut: 1, fin: 5, dx: 0.35, dy: -1 },
  { id: 'folliculaire', nom: en ? 'Follicular' : 'Folliculaire', debut: 6, fin: 13, dx: 1, dy: 0.25 },
  { id: 'ovulation', nom: 'Ovulation', debut: 14, fin: 14, dx: -0.2, dy: 1 },
  { id: 'luteale', nom: en ? 'Luteal' : 'Lutéale', debut: 15, fin: 28, dx: -1, dy: -0.3 },
].map((p) => {
  const milieu = (p.debut + p.fin + 1) / 2;
  const [lx, ly] = pt(milieu, R - 34);
  return { ...p, d: secteur(p.debut, p.fin), lx, ly };
});
const zone = secteur(17, 28, 0.14, R + EP + 9, 4);
// 28 perles (une par jour), plus grosses en début de semaine.
const perles = Array.from({ length: jours }, (_, i) => {
  const j = i + 1;
  const [x, y] = pt(j + 0.5, R + 27);
  const [nx, ny] = pt(j + 0.5, R + 44);
  return { j, x, y, nx, ny, fort: j % 7 === 1 };
});
// Épaisseur des pièces de verre (décalage de la tranche, en unités du dessin).
const EPAISSEUR = 6;
// Légende : ce que représente chaque couche, en langage du cycle (pas de vocabulaire de montre).
const legende = en
  ? [
      { cle: 'jours', titre: '28 days', detail: 'an average cycle' },
      { cle: 'phases', titre: 'Four phases', detail: 'each with its own rules' },
      { cle: 'zone', titre: 'D17 – D28', detail: 'where the guide walks with you' },
      { cle: 'jour', titre: 'Today', detail: 'the day you’re on' },
    ]
  : [
      { cle: 'jours', titre: '28 jours', detail: 'un cycle moyen' },
      { cle: 'phases', titre: 'Quatre phases', detail: 'chacune ses règles' },
      { cle: 'zone', titre: 'J17 – J28', detail: 'là où le guide t’accompagne' },
      { cle: 'jour', titre: 'Aujourd’hui', detail: 'le jour où tu en es' },
    ];
const phasesScript = JSON.stringify(phases.map((p) => [p.debut, p.fin, p.nom]));
---

<div class="wheel" data-wheel data-prefixe={J} data-phases={phasesScript}>
  <div class="wheel__scene">
    <div class="wheel__stack" data-wheel-stack>
      <!-- Axes d'assemblage (pointillés verticaux entre les plateaux, comme sur un dessin d'horloger) -->
      {[45, 135, 225, 315].map((a) => (
        <span class="wheel__axe" data-axe style={`left: ${50 + 52.5 * Math.cos((a * Math.PI) / 180)}%; top: ${50 + 52.5 * Math.sin((a * Math.PI) / 180)}%`}></span>
      ))}
      <!-- 01 · Cadran -->
      <div class="wheel__layer" data-layer="0">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="platine" cx="40%" cy="30%" r="75%">
                <stop offset="0" style="stop-color: var(--color-base-creme); stop-opacity: 0.18" />
                <stop offset="1" style="stop-color: var(--color-base-creme); stop-opacity: 0.03" />
              </radialGradient>
              <radialGradient id="perle" cx="35%" cy="30%" r="70%">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 1" />
                <stop offset="0.45" style="stop-color: var(--color-base-sauge); stop-opacity: 0.9" />
                <stop offset="1" style="stop-color: var(--color-profondeur-vert-nuit); stop-opacity: 1" />
              </radialGradient>
              <radialGradient id="perle-rose" cx="35%" cy="30%" r="70%">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 1" />
                <stop offset="0.4" style="stop-color: var(--color-accent-fuchsia); stop-opacity: 1" />
                <stop offset="1" style="stop-color: var(--color-profondeur-vert-nuit); stop-opacity: 1" />
              </radialGradient>
              <linearGradient id="biseau" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.55" />
                <stop offset="0.5" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.05" />
                <stop offset="1" style="stop-color: var(--color-profondeur-vert-nuit); stop-opacity: 0.8" />
              </linearGradient>
            </defs>
            <!-- Platine biseautée : tranche sombre décalée + face claire -->
            <circle cx={C} cy={C + EPAISSEUR} r={R + 54} class="wheel__platine-tranche" />
            <circle cx={C} cy={C} r={R + 54} class="wheel__platine" />
            <circle cx={C} cy={C} r={R + 54} class="wheel__biseau" />
            {perles.map((p) => (
              <g class="wheel__perle">
                <ellipse cx={p.x + 1.2} cy={p.y + 2.4} rx={p.fort ? 4.4 : 3} ry={p.fort ? 2.6 : 1.8} class="wheel__perle-ombre" />
                <circle cx={p.x} cy={p.y} r={p.fort ? 4.4 : 2.9} fill={p.j >= 17 ? 'url(#perle-rose)' : 'url(#perle)'} />
              </g>
            ))}
            {perles.filter((p) => p.fort || p.j === 17 || p.j === 28).map((p) => <text class="wheel__num" x={p.nx} y={p.ny}>{p.j}</text>)}
          </svg>
        </div>
      </div>

      <!-- 02 · Quatre phases en verre liquide -->
      <div class="wheel__layer" data-layer="1">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="verre" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-creme); stop-opacity: 0.38" />
                <stop offset="0.45" style="stop-color: var(--color-base-creme); stop-opacity: 0.12" />
                <stop offset="1" style="stop-color: var(--color-base-creme); stop-opacity: 0.05" />
              </linearGradient>
              <linearGradient id="reflet" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.35" />
                <stop offset="0.35" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0" />
              </linearGradient>
              <linearGradient id="arete" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.95" />
                <stop offset="0.5" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.15" />
                <stop offset="1" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.5" />
              </linearGradient>
            </defs>
            {phases.map((p) => (
              <g class="wheel__quartier" data-wheel-part data-dx={p.dx} data-dy={p.dy}>
                <path class="wheel__ombre" d={p.d} transform={`translate(4 ${EPAISSEUR + 8})`} />
                <path class="wheel__tranche" d={p.d} transform={`translate(0 ${EPAISSEUR})`} />
                <path class="wheel__verre" d={p.d} />
                <path class="wheel__reflet" d={p.d} />
                <path class="wheel__arete" d={p.d} />
              </g>
            ))}
          </svg>
          <!-- Noms des phases : texte en relief, toujours face à nous -->
          {phases.map((p) => (
            <span class="wheel__label-pos" style={`left: ${(p.lx / 4).toFixed(2)}%; top: ${(p.ly / 4).toFixed(2)}%`}>
              <span class="wheel__label wheel__face">{p.nom}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- 03 · Ta zone J17–J28 -->
      <div class="wheel__layer" data-layer="2">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="verre-rose" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-accent-fuchsia); stop-opacity: 1" />
                <stop offset="1" style="stop-color: var(--color-accent-fuchsia-profond); stop-opacity: 0.85" />
              </linearGradient>
              <linearGradient id="reflet-rose" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.45" />
                <stop offset="0.4" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0" />
              </linearGradient>
            </defs>
            <path class="wheel__zone-tranche" d={zone} transform={`translate(0 ${EPAISSEUR - 2})`} />
            <path class="wheel__zone" d={zone} />
            <path class="wheel__reflet wheel__reflet--rose" d={zone} />
          </svg>
        </div>
      </div>

      <!-- 04 · Aiguille du jour + compteur -->
      <div class="wheel__layer" data-layer="3">
        <div class="wheel__piece" data-piece>
          <!-- Ombres couchées sur le plan (la sphère et la bille elles-mêmes sont au premier plan, plus bas) -->
          <span class="wheel__sphere-ombre"></span>
          <span class="wheel__bille-ombre" data-bille-ombre></span>
          <!-- Points d'ancrage : leur position projetée à l'écran place la sphère et la bille -->
          <span class="wheel__ancre" data-ancre-sphere style="left: 50%; top: 50%"></span>
          <span class="wheel__ancre" data-ancre-echelle style="left: 60%; top: 50%"></span>
          <span class="wheel__ancre" data-bille></span>
        </div>
      </div>
    </div>

    <!-- Premier plan : vraies sphères, toujours rondes (aucune déformation de perspective) -->
    <div class="wheel__avant" data-avant>
      <div class="wheel__sphere" data-sphere>
        <div class="wheel__sphere-corps">
          <span class="wheel__day" data-day>{J}17</span>
          <span class="wheel__phase-name" data-phase>{en ? 'Luteal' : 'Lutéale'}</span>
        </div>
      </div>
      <span class="wheel__bille" data-bille-visuel>
        <span class="wheel__bille-marque" data-bille-marque></span>
      </span>
    </div>
  </div>

  <ol class="wheel__legende" aria-hidden="true">
    {legende.map((l) => (
      <li data-legende><span class:list={['wheel__puce', `wheel__puce--${l.cle}`]}></span><span><strong>{l.titre}</strong> {l.detail}</span></li>
    ))}
  </ol>
</div>

<script>
  // La bille « aujourd'hui » roule dans la gorge de l'anneau :
  //  1. pendant la vue éclatée (classe is-eclatee) : elle file vite, en continu ;
  //  2. une fois la roue assemblée : elle fait un dernier tour complet en ralentissant, et se pose sur J17.
  // Sa marque tourne avec la distance parcourue : on la voit rouler.
  // Performance : on ne lit les positions 3D (getBoundingClientRect) que pendant la vue éclatée ;
  // roue assemblée, tout se calcule à plat. La boucle s'arrête quand la bille est posée.
  const R_POURCENT = 39.5; // rayon de la gorge, en % de la largeur du dessin (158 / 400)
  const VITESSE_ECLATEE = 9; // jours par seconde
  const DUREE_DERNIER_TOUR = 3600; // ms
  const JOUR_FINAL = 17;
  const adoucir = (t: number) => 1 - Math.pow(1 - t, 3); // départ vif, arrivée en douceur
  for (const wheel of document.querySelectorAll<HTMLElement>('[data-wheel]')) {
    const ancreBille = wheel.querySelector<HTMLElement>('[data-bille]')!;
    const scene = wheel.querySelector<HTMLElement>('.wheel__scene')!;
    const ancreSphere = wheel.querySelector<HTMLElement>('[data-ancre-sphere]')!;
    const ancreEchelle = wheel.querySelector<HTMLElement>('[data-ancre-echelle]')!;
    const sphere = wheel.querySelector<HTMLElement>('[data-sphere]')!;
    const billeVisuel = wheel.querySelector<HTMLElement>('[data-bille-visuel]')!;
    const ombre = wheel.querySelector<HTMLElement>('[data-bille-ombre]')!;
    const marque = wheel.querySelector<HTMLElement>('[data-bille-marque]')!;
    const day = wheel.querySelector<HTMLElement>('[data-day]')!;
    const phase = wheel.querySelector<HTMLElement>('[data-phase]')!;
    const phases = JSON.parse(wheel.dataset.phases || '[]') as [number, number, string][];
    const prefixe = wheel.dataset.prefixe || 'J';
    sphere.style.left = sphere.style.top = '0';
    billeVisuel.style.display = 'block';

    let jourAffiche = 0;
    const position = (jourFlottant: number) => {
      const a = ((jourFlottant - 1 + 0.5) / 28) * 2 * Math.PI; // au milieu de la case du jour
      return [50 + R_POURCENT * Math.sin(a), 50 - R_POURCENT * Math.cos(a)];
    };
    const placer = (jourFlottant: number, eclatee: boolean) => {
      const [x, y] = position(jourFlottant);
      ancreBille.style.left = ombre.style.left = `${x}%`;
      ancreBille.style.top = ombre.style.top = `${y}%`;
      marque.style.transform = `rotate(${jourFlottant * 168}deg)`;
      if (eclatee) {
        // Positions projetées des ancres (elles suivent les plateaux en 3D).
        const sc = scene.getBoundingClientRect();
        const a = ancreSphere.getBoundingClientRect();
        const e = ancreEchelle.getBoundingClientRect();
        const b = ancreBille.getBoundingClientRect();
        const k = Math.hypot(e.x - a.x, e.y - a.y) / (sc.width * 0.1) || 1;
        sphere.style.transform = `translate3d(${a.x - sc.x}px, ${a.y - sc.y}px, 0) scale(${k})`;
        billeVisuel.style.transform = `translate3d(${b.x - sc.x}px, ${b.y - sc.y}px, 0) scale(${k})`;
      } else {
        const w = scene.offsetWidth;
        sphere.style.transform = `translate3d(${w / 2}px, ${w / 2}px, 0)`;
        billeVisuel.style.transform = `translate3d(${(x / 100) * w}px, ${(y / 100) * w}px, 0)`;
      }
      const j = ((Math.floor(jourFlottant - 1) % 28) + 28) % 28 + 1;
      if (j !== jourAffiche) {
        jourAffiche = j;
        day.textContent = `${prefixe}${j}`;
        phase.textContent = phases.find(([d, f]) => j >= d && j <= f)![2];
        wheel.classList.toggle('is-zone', j >= 17);
      }
    };

    let jour = JOUR_FINAL;
    placer(jour, false);
    addEventListener('resize', () => placer(jour, wheel.classList.contains('is-eclatee')));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    let avant = performance.now();
    let dernierTour: { depart: number; arrivee: number; t0: number } | null = null;
    const boucle = (t: number) => {
      const dt = Math.min(0.05, (t - avant) / 1000);
      avant = t;
      const eclatee = wheel.classList.contains('is-eclatee');
      if (eclatee) {
        jour += VITESSE_ECLATEE * dt;
        placer(jour, true);
        return requestAnimationFrame(boucle);
      }
      if (!wheel.dataset.assemblee && document.documentElement.classList.contains('js-motion')) {
        // Entrée pas encore jouée (roue hors écran) : on attend. Sans animations d'entrée, on fait le tour tout de suite.
        placer(jour, false);
        return requestAnimationFrame(boucle);
      }
      if (!dernierTour) {
        // Dernier tour : au moins 28 jours de plus, jusqu'au prochain J17.
        let arrivee = Math.ceil((jour - JOUR_FINAL) / 28) * 28 + JOUR_FINAL;
        if (arrivee - jour < 28) arrivee += 28;
        dernierTour = { depart: jour, arrivee, t0: t };
      }
      const k = Math.min(1, (t - dernierTour.t0) / DUREE_DERNIER_TOUR);
      jour = dernierTour.depart + (dernierTour.arrivee - dernierTour.depart) * adoucir(k);
      placer(jour, false);
      if (k < 1) requestAnimationFrame(boucle); // posée : la boucle s'arrête
    };
    requestAnimationFrame(boucle);
  }
</script>

<style>
  .wheel { position: relative; width: min(100%, 30rem); margin-inline: auto; }
  .wheel__scene { position: relative; aspect-ratio: 1; perspective: 3200px; perspective-origin: 50% 40%; }
  .wheel__stack { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .wheel__layer { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .wheel__piece { position: absolute; inset: 0; transform-style: preserve-3d; }
  .wheel__piece svg { width: 100%; height: 100%; overflow: visible; }

  .wheel__axe {
    position: absolute; width: 0; height: var(--hauteur-axes, 0px); translate: 0 -100%;
    border-left: 1px dashed rgb(255 253 249 / 0.35);
    transform-origin: 50% 100%; transform: rotateX(-90deg); opacity: 0;
  }
  :global(.motion) .wheel.is-eclatee .wheel__axe { opacity: 1; }
  /* 01 platine et perles des jours */
  .wheel__platine-tranche { fill: var(--semantic-bg-deep-intense); opacity: 0.85; }
  .wheel__platine { fill: url(#platine); }
  .wheel__biseau { fill: none; stroke: url(#biseau); stroke-width: 2.5; }
  .wheel__perle-ombre { fill: rgb(0 0 0 / 0.32); }
  .wheel__num { fill: var(--semantic-text-on-deep-muted); font-family: var(--font-family-body); font-size: 9px; letter-spacing: 0.08em; text-anchor: middle; dominant-baseline: middle; }

  /* 02 phases : verre épais (ombre portée, tranche, face, reflet, arête) */
  .wheel__ombre { fill: rgb(0 0 0 / 0.22); }
  .wheel__tranche { fill: rgb(18 34 25 / 0.75); stroke: rgb(255 253 249 / 0.12); stroke-width: 0.8; }
  .wheel__verre { fill: url(#verre); }
  .wheel__reflet { fill: url(#reflet); }
  .wheel__reflet--rose { fill: url(#reflet-rose); }
  .wheel__arete { fill: none; stroke: url(#arete); stroke-width: 1.1; }
  .wheel__label-pos { position: absolute; width: 0; height: 0; transform-style: preserve-3d; }
  .wheel__label {
    position: absolute; left: 0; top: 0; translate: -50% -50%; white-space: nowrap;
    font-family: var(--font-family-body); font-size: clamp(0.55rem, 1.6vw, 0.66rem); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--semantic-text-on-deep); opacity: 0.85;
    text-shadow: 0 1px 0 rgb(0 0 0 / 0.35), 0 2px 4px rgb(0 0 0 / 0.45);
  }

  /* 03 zone */
  .wheel__zone-tranche { fill: var(--color-accent-fuchsia-profond); filter: brightness(0.55); }
  .wheel__zone { fill: url(#verre-rose); }

  .wheel__ancre { position: absolute; width: 0; height: 0; }
  .wheel__avant { position: absolute; inset: 0; pointer-events: none; }

  /* 04 sphère centrale : verre vert profond, reflet, texte gravé en relief */
  /* Sans JavaScript : sphère centrée, bille masquée. Avec JavaScript : placées sur leurs ancres. */
  .wheel__sphere { position: absolute; left: 50%; top: 50%; width: 34%; aspect-ratio: 1; margin: -17% 0 0 -17%; transform-origin: 50% 50%; }
  .wheel__sphere-ombre { position: absolute; left: 50%; top: 50%; width: 34%; height: 34%; translate: -46% -40%; border-radius: 50%; background: radial-gradient(closest-side, rgb(0 0 0 / 0.5), transparent); }
  .wheel__sphere-corps {
    position: absolute; inset: 0; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background:
      radial-gradient(circle at 32% 26%, rgb(255 253 249 / 0.55) 0%, rgb(255 253 249 / 0) 18%),
      radial-gradient(circle at 70% 85%, rgb(159 192 176 / 0.35) 0%, rgb(159 192 176 / 0) 35%),
      radial-gradient(circle at 42% 38%, var(--color-profondeur-vert-mousse) 0%, var(--color-profondeur-vert-bouteille) 55%, var(--color-profondeur-vert-nuit) 100%);
    box-shadow:
      inset -10px -14px 26px rgb(0 0 0 / 0.5),
      inset 6px 8px 16px rgb(255 253 249 / 0.12),
      0 0 0 1px rgb(255 253 249 / 0.14),
      0 26px 40px -16px rgb(0 0 0 / 0.7);
  }
  .wheel.is-zone .wheel__sphere-corps { box-shadow: inset -10px -14px 26px rgb(0 0 0 / 0.5), inset 6px 8px 16px rgb(255 253 249 / 0.12), 0 0 0 1px rgb(224 37 122 / 0.45), 0 0 34px -6px rgb(224 37 122 / 0.45), 0 26px 40px -16px rgb(0 0 0 / 0.7); }
  .wheel__day {
    font-family: 'Limelight', var(--font-family-display); font-size: clamp(2.2rem, 6.4vw, 3.6rem); line-height: 1; color: var(--color-base-blanc-chaud); font-variant-numeric: tabular-nums;
    /* Relief : tranche en couches successives + ombre portée sur la sphère */
    text-shadow: 0 1px 0 color-mix(in srgb, var(--color-base-creme) 88%, var(--color-profondeur-vert-nuit)), 0 2px 0 color-mix(in srgb, var(--color-base-creme) 75%, var(--color-profondeur-vert-nuit)), 0 3px 0 color-mix(in srgb, var(--color-base-creme) 62%, var(--color-profondeur-vert-nuit)), 0 4px 0 color-mix(in srgb, var(--color-base-creme) 50%, var(--color-profondeur-vert-nuit)), 0 6px 6px rgb(0 0 0 / 0.45), 0 12px 20px rgb(0 0 0 / 0.35);
  }
