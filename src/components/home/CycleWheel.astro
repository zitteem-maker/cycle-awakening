---
// Roue du cycle (28 jours) : visuel signature du hero. Un repère fait le tour du cycle,
// le compteur central affiche le jour et la phase ; l'arc fuchsia marque J17–J28, la zone du guide.
// Décorative pour les lecteurs d'écran (le texte du hero porte l'information). Figée si mouvement réduit.
const C = 200;
const R = 160;
const jours = 28;
const angle = (j: number) => ((j - 1) / jours) * 2 * Math.PI - Math.PI / 2;
const pt = (j: number, r = R) => [C + r * Math.cos(angle(j)), C + r * Math.sin(angle(j))];
function arc(debut: number, fin: number, r = R, ecart = 0.12) {
  const [x1, y1] = pt(debut + ecart, r);
  const [x2, y2] = pt(fin + 1 - ecart, r);
  const grand = fin + 1 - debut > jours / 2 ? 1 : 0;
  return `M${x1.toFixed(2)} ${y1.toFixed(2)} A${r} ${r} 0 ${grand} 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
}
// Repères moyens pour un cycle de 28 jours (le texte du site rappelle que chaque cycle est différent).
const phases = [
  { nom: 'Règles', debut: 1, fin: 5 },
  { nom: 'Folliculaire', debut: 6, fin: 13 },
  { nom: 'Ovulation', debut: 14, fin: 14 },
  { nom: 'Lutéale', debut: 15, fin: 28 },
];
const ticks = Array.from({ length: jours }, (_, i) => {
  const j = i + 1;
  const [x1, y1] = pt(j, R + 14);
  const [x2, y2] = pt(j, R + (j % 7 === 1 ? 26 : 20));
  return { x1, y1, x2, y2, fort: j % 7 === 1 };
});
const labels = phases.map((p) => {
  const milieu = (p.debut + p.fin + 1) / 2;
  const [x, y] = pt(milieu, R - 30);
  return { ...p, x, y };
});
---

<div class="wheel" data-wheel>
  <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="wheel-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="var(--color-base-sauge)" stop-opacity="0.22" />
        <stop offset="1" stop-color="var(--color-base-sauge)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx={C} cy={C} r="196" fill="url(#wheel-glow)" />
    <circle class="wheel__orbit" cx={C} cy={C} r={R + 40} />
    {ticks.map((t) => <line class:list={['wheel__tick', { 'wheel__tick--fort': t.fort }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
    {phases.map((p) => <path class="wheel__phase" d={arc(p.debut, p.fin)} />)}
    <path class="wheel__zone" d={arc(17, 28, R, 0)} pathLength="1" />
    {labels.map((l) => <text class="wheel__label" x={l.x} y={l.y}>{l.nom}</text>)}
    <g class="wheel__marker" data-marker>
      <circle cx={C} cy={C - R} r="9" class="wheel__dot" />
      <circle cx={C} cy={C - R} r="16" class="wheel__halo" />
    </g>
  </svg>
  <div class="wheel__center">
    <span class="wheel__day" data-day>J17</span>
    <span class="wheel__phase-name" data-phase>Lutéale</span>
  </div>
</div>

<script>
  const phases: [number, number, string][] = [
    [1, 5, 'Règles'],
    [6, 13, 'Folliculaire'],
    [14, 14, 'Ovulation'],
    [15, 28, 'Lutéale'],
  ];
  for (const wheel of document.querySelectorAll<HTMLElement>('[data-wheel]')) {
    const marker = wheel.querySelector<SVGGElement>('[data-marker]')!;
    const day = wheel.querySelector<HTMLElement>('[data-day]')!;
    const phase = wheel.querySelector<HTMLElement>('[data-phase]')!;
    const set = (j: number) => {
      marker.style.transform = `rotate(${((j - 1) / 28) * 360}deg)`;
      day.textContent = `J${j}`;
      phase.textContent = phases.find(([a, b]) => j >= a && j <= b)![2];
      wheel.classList.toggle('is-zone', j >= 17);
    };
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let j = 17;
    set(j);
    if (!reduit) {
      // Le tour complet prend environ 22 s ; ralentit dans la zone J17–J28 pour laisser lire.
      const tick = () => {
        j = (j % 28) + 1;
        set(j);
        setTimeout(tick, j >= 17 ? 1000 : 600);
      };
      setTimeout(tick, 2200);
    }
  }
</script>

<style>
  .wheel { position: relative; width: min(100%, 30rem); aspect-ratio: 1; margin-inline: auto; }
  .wheel svg { width: 100%; height: 100%; overflow: visible; }
  .wheel__orbit { fill: none; stroke: var(--semantic-text-on-deep-muted); stroke-opacity: 0.35; stroke-width: 0.8; stroke-dasharray: 2 6; transform-origin: 200px 200px; animation: orbit 90s linear infinite; }
  .wheel__tick { stroke: var(--semantic-text-on-deep-muted); stroke-opacity: 0.55; stroke-width: 1; stroke-linecap: round; }
  .wheel__tick--fort { stroke-opacity: 0.9; stroke-width: 1.6; }
  .wheel__phase { fill: none; stroke: var(--semantic-text-on-deep); stroke-opacity: 0.18; stroke-width: 22; }
  .wheel__zone {
    fill: none; stroke: var(--semantic-accent); stroke-width: 22; stroke-linecap: butt;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 1.8s var(--motion-ease) 0.5s forwards;
  }
  .wheel__label { fill: var(--semantic-text-on-deep-muted); font-family: var(--font-family-body); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; text-anchor: middle; dominant-baseline: middle; }
  .wheel__marker { transform-origin: 200px 200px; transition: transform 0.55s var(--motion-ease); }
  .wheel__dot { fill: var(--semantic-text-on-deep); }
  .wheel__halo { fill: none; stroke: var(--semantic-text-on-deep); stroke-opacity: 0.4; animation: pulse 2.4s ease-out infinite; transform-origin: 200px 40px; }
  .wheel__dot { stroke: var(--semantic-bg-deep); stroke-width: 3; }
  .wheel.is-zone .wheel__halo { stroke: var(--semantic-accent); }
  .wheel__center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
  .wheel__day { font-family: 'Limelight', var(--font-family-display); font-size: clamp(3.2rem, 9vw, 5.2rem); line-height: 1; color: var(--semantic-text-on-deep); font-variant-numeric: tabular-nums; }
  .wheel__phase-name { font-family: var(--font-family-display); font-style: italic; font-size: var(--font-size-lg); color: var(--semantic-text-on-deep-muted); margin-top: var(--space-2); }
  .wheel.is-zone .wheel__phase-name { color: var(--semantic-text-on-deep); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes orbit { to { transform: rotate(360deg); } }
  @keyframes pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .wheel__zone { stroke-dashoffset: 0; animation: none; }
    .wheel__orbit, .wheel__halo { animation: none; }
  }
</style>
