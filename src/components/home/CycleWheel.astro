---
// Roue du cycle (28 jours), visuel signature du hero, dessinée comme une VUE ÉCLATÉE DE MONTRE :
// quatre plateaux superposés en 3D, repérés 01 à 04 et légendés.
//   01 les 28 jours (graduations) · 02 les quatre phases en verre liquide
//   03 ta zone J17–J28 (verre fuchsia) · 04 le repère du jour + le compteur
// src/scripts/motion.ts : les plateaux se posent en vue éclatée, puis s'assemblent au défilement.
// Sans JavaScript ou en mouvement réduit : la roue s'affiche assemblée, à plat. Décorative (aria-hidden).
const C = 200;
const R = 158;
const EP = 13;
const jours = 28;
const angle = (j: number) => ((j - 1) / jours) * 2 * Math.PI - Math.PI / 2;
const pt = (j: number, r: number) => [C + r * Math.cos(angle(j)), C + r * Math.sin(angle(j))];
const f = (n: number) => n.toFixed(2);
function secteur(debut: number, fin: number, ecart = 0.14, r = R, ep = EP) {
  const a = debut + ecart;
  const b = fin + 1 - ecart;
  const grand = b - a > jours / 2 ? 1 : 0;
  const [x1, y1] = pt(a, r + ep);
  const [x2, y2] = pt(b, r + ep);
  const [x3, y3] = pt(b, r - ep);
  const [x4, y4] = pt(a, r - ep);
  return `M${f(x1)} ${f(y1)} A${r + ep} ${r + ep} 0 ${grand} 1 ${f(x2)} ${f(y2)} L${f(x3)} ${f(y3)} A${r - ep} ${r - ep} 0 ${grand} 0 ${f(x4)} ${f(y4)} Z`;
}
// Repères moyens pour un cycle de 28 jours (le site rappelle que chaque cycle est différent).
const phases = [
  { id: 'regles', nom: 'Règles', debut: 1, fin: 5, dx: 0.35, dy: -1 },
  { id: 'folliculaire', nom: 'Folliculaire', debut: 6, fin: 13, dx: 1, dy: 0.25 },
  { id: 'ovulation', nom: 'Ovulation', debut: 14, fin: 14, dx: -0.2, dy: 1 },
  { id: 'luteale', nom: 'Lutéale', debut: 15, fin: 28, dx: -1, dy: -0.3 },
].map((p) => {
  const milieu = (p.debut + p.fin + 1) / 2;
  const [lx, ly] = pt(milieu, R - 34);
  return { ...p, d: secteur(p.debut, p.fin), lx, ly };
});
const zone = secteur(17, 28, 0.14, R + EP + 9, 4);
const ticks = Array.from({ length: jours }, (_, i) => {
  const j = i + 1;
  const [x1, y1] = pt(j, R + 20);
  const [x2, y2] = pt(j, R + (j % 7 === 1 ? 32 : 26));
  const [nx, ny] = pt(j, R + 44);
  return { j, x1, y1, x2, y2, nx, ny, fort: j % 7 === 1 };
});
// Légende : ce que représente chaque couche, en langage du cycle (pas de vocabulaire de montre).
const legende = [
  { cle: 'jours', titre: '28 jours', detail: 'un cycle moyen' },
  { cle: 'phases', titre: 'Quatre phases', detail: 'chacune ses règles' },
  { cle: 'zone', titre: 'J17 – J28', detail: 'là où le guide t’accompagne' },
  { cle: 'jour', titre: 'Aujourd’hui', detail: 'le jour où tu en es' },
];
---

<div class="wheel" data-wheel>
  <div class="wheel__scene">
    <div class="wheel__stack" data-wheel-stack>
      <!-- Axes d'assemblage (pointillés verticaux entre les plateaux, comme sur un dessin d'horloger) -->
      {[45, 135, 225, 315].map((a) => (
        <span class="wheel__axe" data-axe style={`left: ${50 + 52.5 * Math.cos((a * Math.PI) / 180)}%; top: ${50 + 52.5 * Math.sin((a * Math.PI) / 180)}%`}></span>
      ))}
      <!-- 01 · Cadran -->
      <div class="wheel__layer" data-layer="0">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="platine" cx="40%" cy="30%" r="75%">
                <stop offset="0" style="stop-color: var(--color-base-creme); stop-opacity: 0.16" />
                <stop offset="1" style="stop-color: var(--color-base-creme); stop-opacity: 0.03" />
              </radialGradient>
            </defs>
            <circle cx={C} cy={C} r={R + 52} class="wheel__platine" />
            <circle class="wheel__orbit" cx={C} cy={C} r={R + 52} />
            {ticks.map((t) => <line class:list={['wheel__tick', { 'wheel__tick--fort': t.fort }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
            {ticks.filter((t) => t.fort || t.j === 17 || t.j === 28).map((t) => <text class="wheel__num" x={t.nx} y={t.ny}>{t.j}</text>)}
          </svg>
        </div>
      </div>

      <!-- 02 · Quatre phases en verre liquide -->
      <div class="wheel__layer" data-layer="1">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="verre" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-creme); stop-opacity: 0.38" />
                <stop offset="0.45" style="stop-color: var(--color-base-creme); stop-opacity: 0.12" />
                <stop offset="1" style="stop-color: var(--color-base-creme); stop-opacity: 0.05" />
              </linearGradient>
              <linearGradient id="arete" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.95" />
                <stop offset="0.5" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.15" />
                <stop offset="1" style="stop-color: var(--color-base-blanc-chaud); stop-opacity: 0.5" />
              </linearGradient>
            </defs>
            {phases.map((p) => (
              <g class="wheel__quartier" data-wheel-part data-dx={p.dx} data-dy={p.dy}>
                <path class="wheel__verre" d={p.d} />
                <path class="wheel__arete" d={p.d} />
              </g>
            ))}
            {phases.map((p) => <text class="wheel__label" x={p.lx} y={p.ly}>{p.nom}</text>)}
          </svg>
        </div>
      </div>

      <!-- 03 · Ta zone J17–J28 -->
      <div class="wheel__layer" data-layer="2">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="verre-rose" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" style="stop-color: var(--color-accent-fuchsia); stop-opacity: 1" />
                <stop offset="1" style="stop-color: var(--color-accent-fuchsia-profond); stop-opacity: 0.75" />
              </linearGradient>
            </defs>
            <path class="wheel__zone" d={zone} />
          </svg>
        </div>
      </div>

      <!-- 04 · Aiguille du jour + compteur -->
      <div class="wheel__layer" data-layer="3">
        <div class="wheel__piece" data-piece>
          <svg viewBox="0 0 400 400" aria-hidden="true" focusable="false">
            <g class="wheel__marker" data-marker>
              <circle cx={C} cy={C - R} r="17" class="wheel__halo" />
              <circle cx={C} cy={C - R} r="8.5" class="wheel__dot" />
            </g>
            <circle cx={C} cy={C} r="62" class="wheel__cabochon" />
          </svg>
          <div class="wheel__center">
            <span class="wheel__day" data-day>J17</span>
            <span class="wheel__phase-name" data-phase>Lutéale</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ol class="wheel__legende" aria-hidden="true">
    {legende.map((l) => (
      <li data-legende><span class:list={['wheel__puce', `wheel__puce--${l.cle}`]}></span><span><strong>{l.titre}</strong> {l.detail}</span></li>
    ))}
  </ol>
</div>

<script>
  const phases: [number, number, string][] = [
    [1, 5, 'Règles'],
    [6, 13, 'Folliculaire'],
    [14, 14, 'Ovulation'],
    [15, 28, 'Lutéale'],
  ];
  // Le repère du jour tourne en continu : vite pendant la vue éclatée (classe is-eclatee), puis à un
  // rythme posé, en ralentissant dans la zone J17–J28 pour laisser lire.
  for (const wheel of document.querySelectorAll<HTMLElement>('[data-wheel]')) {
    const marker = wheel.querySelector<SVGGElement>('[data-marker]')!;
    const day = wheel.querySelector<HTMLElement>('[data-day]')!;
    const phase = wheel.querySelector<HTMLElement>('[data-phase]')!;
    let jourAffiche = 0;
    const afficher = (angleDeg: number) => {
      marker.style.transform = `rotate(${angleDeg}deg)`;
      const j = (Math.floor(((angleDeg % 360) + 360) % 360 / (360 / 28)) % 28) + 1;
      if (j === jourAffiche) return;
      jourAffiche = j;
      day.textContent = `J${j}`;
      phase.textContent = phases.find(([a, b]) => j >= a && j <= b)![2];
      wheel.classList.toggle('is-zone', j >= 17);
    };
    let angle = (16 / 28) * 360; // J17
    afficher(angle);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let avant = performance.now();
      const boucle = (t: number) => {
        const dt = Math.min(0.05, (t - avant) / 1000);
        avant = t;
        const eclatee = wheel.classList.contains('is-eclatee');
        const vitesse = eclatee ? 110 : jourAffiche >= 17 ? 11 : 20; // degrés par seconde
        angle += vitesse * dt;
        afficher(angle);
        requestAnimationFrame(boucle);
      };
      requestAnimationFrame(boucle);
    }
  }
</script>

<style>
  .wheel { position: relative; width: min(100%, 30rem); margin-inline: auto; }
  .wheel__scene { position: relative; aspect-ratio: 1; perspective: 1600px; perspective-origin: 50% 30%; }
  .wheel__stack { position: absolute; inset: 0; transform-style: preserve-3d; }
  .wheel__layer { position: absolute; inset: 0; transform-style: preserve-3d; }
  .wheel__piece { position: absolute; inset: 0; transform-style: preserve-3d; }
  .wheel__piece svg { width: 100%; height: 100%; overflow: visible; }

  .wheel__axe {
    position: absolute; width: 0; height: var(--hauteur-axes, 0px); translate: 0 -100%;
    border-left: 1px dashed rgb(255 253 249 / 0.35);
    transform-origin: 50% 100%; transform: rotateX(-90deg); opacity: 0;
  }
  :global(.motion) .wheel.is-eclatee .wheel__axe { opacity: 1; }
  /* 01 cadran */
  .wheel__platine { fill: url(#platine); stroke: rgb(255 253 249 / 0.16); stroke-width: 1; }
  .wheel__orbit { fill: none; stroke: var(--semantic-text-on-deep-muted); stroke-opacity: 0.4; stroke-width: 0.8; stroke-dasharray: 2 6; }
  .wheel__tick { stroke: var(--semantic-text-on-deep-muted); stroke-opacity: 0.65; stroke-width: 1; stroke-linecap: round; }
  .wheel__tick--fort { stroke-opacity: 1; stroke-width: 1.6; }
  .wheel__num { fill: var(--semantic-text-on-deep-muted); font-family: var(--font-family-body); font-size: 9px; letter-spacing: 0.08em; text-anchor: middle; dominant-baseline: middle; }

  /* 02 phases */
  .wheel__verre { fill: url(#verre); }
  .wheel__arete { fill: none; stroke: url(#arete); stroke-width: 1.1; }
  .wheel__label { fill: var(--semantic-text-on-deep-muted); font-family: var(--font-family-body); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; text-anchor: middle; dominant-baseline: middle; }

  /* 03 zone */
  .wheel__zone { fill: url(#verre-rose); filter: drop-shadow(0 0 6px rgb(224 37 122 / 0.6)); }

  /* 04 repère du jour */
  .wheel__marker { transform-origin: 200px 200px; }
  /* Pendant la vue éclatée : le repère file, avec une traînée lumineuse. */
  .wheel.is-eclatee .wheel__dot { filter: drop-shadow(0 0 8px rgb(255 253 249 / 0.9)); }
  .wheel.is-eclatee.is-zone .wheel__dot { filter: drop-shadow(0 0 10px rgb(224 37 122 / 0.95)); }
  .wheel__dot { fill: var(--semantic-text-on-deep); stroke: var(--semantic-bg-deep); stroke-width: 3; }
  .wheel__halo { fill: rgb(247 244 239 / 0.12); stroke: var(--semantic-text-on-deep); stroke-opacity: 0.45; animation: pulse 2.4s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  .wheel.is-zone .wheel__halo { stroke: var(--semantic-accent); }
  .wheel__cabochon { fill: rgb(18 34 25 / 0.55); stroke: rgb(255 253 249 / 0.25); stroke-width: 1; }
  .wheel__center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
  .wheel__day { font-family: 'Limelight', var(--font-family-display); font-size: clamp(2.6rem, 7vw, 4.2rem); line-height: 1; color: var(--semantic-text-on-deep); font-variant-numeric: tabular-nums; text-shadow: 0 2px 0 rgb(0 0 0 / 0.25), 0 10px 26px rgb(0 0 0 / 0.45); }
  .wheel__phase-name { font-family: var(--font-family-display); font-style: italic; font-size: var(--font-size-base); color: var(--semantic-text-on-deep-muted); margin-top: var(--space-1); }
  .wheel.is-zone .wheel__phase-name { color: var(--semantic-text-on-deep); }

  /* Légende sur le côté */
  .wheel__legende { list-style: none; margin: 0; padding: 0; display: none; }
  .wheel__legende li { display: flex; gap: var(--space-3); align-items: baseline; font-size: var(--font-size-xs); color: var(--semantic-text-on-deep-muted); }
  .wheel__legende strong { color: var(--semantic-text-on-deep); font-weight: var(--font-weight-medium); }
  .wheel__puce { flex: none; width: 0.8rem; height: 0.8rem; border-radius: 50%; translate: 0 0.1rem; }
  .wheel__puce--jours { border: 1px dashed var(--semantic-text-on-deep-muted); }
  .wheel__puce--phases { background: linear-gradient(145deg, rgb(255 253 249 / 0.6), rgb(247 244 239 / 0.15)); border: 1px solid rgb(255 253 249 / 0.5); }
  .wheel__puce--zone { background: var(--semantic-accent); }
  .wheel__puce--jour { background: var(--semantic-text-on-deep); box-shadow: 0 0 0 3px rgb(247 244 239 / 0.2); }

  /* Vue éclatée active (classe posée par motion.ts) : repères et légende visibles. */
  :global(.motion) .wheel__legende { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2) var(--space-6); margin-top: var(--space-6); }
  @media (min-width: 60rem) {
    :global(.motion) .wheel__legende { margin-top: var(--space-8); }
  }

  @keyframes pulse { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.5); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .wheel__halo { animation: none; } }
</style>
