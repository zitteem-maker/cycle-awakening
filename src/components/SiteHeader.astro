---
import Logo from './Logo.astro';
import Cta from './Cta.astro';
interface Props { cta?: boolean }
const { cta = true } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Cycle Awakening, accueil">
      <Logo class="site-header__svg" />
    </a>
    {cta && <div class="site-header__cta"><Cta location="header" variant="secondary" /></div>}
  </div>
</header>

<style>
  .site-header { padding-block: var(--space-4); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .site-header__logo { color: var(--semantic-text); display: inline-flex; min-height: var(--size-tap-target); align-items: center; }
  .site-header__logo :global(svg) { width: clamp(11rem, 30vw, 14rem); height: auto; }
  .site-header__cta :global(.cta-note) { display: none; }
  @media (max-width: 40rem) { .site-header__cta { display: none; } }
</style>
