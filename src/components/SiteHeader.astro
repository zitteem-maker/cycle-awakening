---
// En-tête collant. Mode « overlay » : transparent sur le hero profond, crème flouté dès qu'on défile.
// Menu mobile accessible (bouton avec aria-expanded, fermeture avec Échap).
import Logo from './Logo.astro';
import Cta from './Cta.astro';
interface Props { cta?: boolean; overlay?: boolean }
const { cta = true, overlay = false } = Astro.props;
const liens = [
  { href: '/#guide', label: 'Le guide' },
  { href: '/blog', label: 'Blog' },
  { href: '/recommandations', label: 'Recommandations' },
  { href: '/#faq', label: 'Questions' },
  { href: '/#newsletter', label: 'Newsletter' },
];
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Cycle Awakening, accueil">
      <Logo class="site-header__svg" />
    </a>
    <nav class="site-header__nav" id="menu-principal" aria-label="Navigation principale">
      <ul>
        {liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      {cta && <div class="site-header__cta"><Cta location="header" variant="primary" /></div>}
    </nav>
    <button class="site-header__burger" type="button" aria-expanded="false" aria-controls="menu-principal" data-burger>
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
    const close = () => { header.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); };
    burger.addEventListener('click', () => {
      const open = !header.classList.contains('is-open');
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
    });
    header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; padding-block: var(--space-3);
    color: var(--semantic-text);
    transition: background-color var(--motion-duration-base) var(--motion-ease), color var(--motion-duration-base) var(--motion-ease), box-shadow var(--motion-duration-base) var(--motion-ease);
  }
  .site-header--overlay { position: fixed; inset: 0 0 auto 0; color: var(--semantic-text-on-deep); }
  .site-header--overlay.is-scrolled, .site-header--overlay.is-open { color: var(--semantic-text); }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-6);
    border-radius: var(--radius-pill); border: 1px solid transparent;
    transition: background-color var(--motion-duration-base) var(--motion-ease), box-shadow var(--motion-duration-base) var(--motion-ease), padding var(--motion-duration-base) var(--motion-ease), border-color var(--motion-duration-base) var(--motion-ease);
  }
  /* Au défilement : barre de verre liquide flottante. */
  .site-header.is-scrolled .site-header__inner, .site-header:not(.site-header--overlay) .site-header__inner, .site-header.is-open .site-header__inner {
    max-width: calc(var(--size-container) - 2rem); padding-inline: var(--space-6);
    background: linear-gradient(145deg, rgb(255 253 249 / 0.78), rgb(247 244 239 / 0.5));
    border-color: rgb(255 253 249 / 0.8);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), 0 18px 40px -22px rgb(18 34 25 / 0.45);
    backdrop-filter: blur(20px) saturate(1.7); -webkit-backdrop-filter: blur(20px) saturate(1.7);
  }
  .site-header.is-open .site-header__inner { border-radius: 24px 24px 0 0; }
  .site-header__logo { color: inherit; display: inline-flex; min-height: var(--size-tap-target); align-items: center; }
  .site-header__logo :global(svg) { width: clamp(10rem, 28vw, 13rem); height: auto; }
  .site-header__nav { display: flex; align-items: center; gap: var(--space-8); white-space: nowrap; }
  .site-header__nav ul { list-style: none; display: flex; gap: var(--space-6); margin: 0; padding: 0; white-space: nowrap; }
  .site-header__nav a:not(.cta) {
    color: inherit; text-decoration: none; font-size: var(--font-size-xs); letter-spacing: 0.12em; text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-block: var(--space-2);
    transition: background-size var(--motion-duration-base) var(--motion-ease);
  }
  .site-header__nav a:not(.cta):hover { background-size: 100% 1px; }
  .site-header__cta :global(.cta-note) { display: none; }
  .site-header--overlay:not(.is-scrolled):not(.is-open) .site-header__cta :global(.cta) { background: var(--semantic-cta-on-deep-bg); color: var(--semantic-cta-on-deep-text); }
  .site-header--overlay:not(.is-scrolled) :focus-visible { outline-color: var(--semantic-focus-on-deep); }
  .site-header__burger { display: none; }

  @media (max-width: 74rem) {
    .site-header__burger {
      display: grid; place-content: center; gap: 6px; width: var(--size-tap-target); height: var(--size-tap-target);
      background: none; border: 0; color: inherit; cursor: pointer;
    }
    .site-header__burger span[aria-hidden] { display: block; width: 24px; height: 1.5px; background: currentColor; transition: transform var(--motion-duration-base) var(--motion-ease); }
    .is-open .site-header__burger span[aria-hidden]:nth-of-type(2) { transform: translateY(3.75px) rotate(45deg); }
    .is-open .site-header__burger span[aria-hidden]:nth-of-type(3) { transform: translateY(-3.75px) rotate(-45deg); }
    .site-header__nav {
      position: absolute; inset: calc(100% - var(--space-3)) var(--space-gutter) auto var(--space-gutter); flex-direction: column; align-items: flex-start; gap: var(--space-6);
      padding: var(--space-8) var(--space-6) var(--space-8); color: var(--semantic-text); border-radius: 0 0 24px 24px;
      background: linear-gradient(170deg, rgb(255 253 249 / 0.92), rgb(247 244 239 / 0.82));
      border: 1px solid rgb(255 253 249 / 0.8); border-top: 0;
      backdrop-filter: blur(24px) saturate(1.6); -webkit-backdrop-filter: blur(24px) saturate(1.6);
      box-shadow: 0 30px 40px -24px rgb(26 48 40 / 0.4);
      visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity var(--motion-duration-base) var(--motion-ease), transform var(--motion-duration-base) var(--motion-ease), visibility 0s linear var(--motion-duration-base);
    }
    .is-open .site-header__nav { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .site-header__nav ul { flex-direction: column; gap: var(--space-4); }
    .site-header__nav a:not(.cta) { font-family: var(--font-family-display); font-size: var(--font-size-xl); letter-spacing: 0; text-transform: none; }
  }
</style>
